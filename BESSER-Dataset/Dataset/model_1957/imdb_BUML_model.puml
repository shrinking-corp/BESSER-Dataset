@startuml
' model: imdb
' project: sampleModel
' owner: User
' description: New project
enum Genre {
  Adventure
  SciFi
}
enum StaffListType {
  characters
  titles
}
class imdb_Movie {
  + age : int
  + criticReviews : int
  + genres : str
  + metaScore : int
  + metacriticReviews : int
  + poster : str
  + rating : float
  + releaseDate : date
  + runtime : int
  + synopsis : str
  + title : str
  + userRatings : int
  + userReviews : int
}
class imdb_Person {
  + name : str
}
class imdb_StaffList {
  + coverPhoto : str
  + createdDate : date
  + elementType : str
  + elements : str
  + name : str
}
class imdb_User {
  + username : str
  + watchlist : str
}
class imdb_db {
  + bestOf2014 : str
  + sam() : str
}
imdb_Movie "imdb_Person6 1..1" -- "imdb_Movie5 0..9999" imdb_Person : actors4
imdb_Person "imdb_db13 0..9999" --* "imdb_Person14 1..1" imdb_db : allActors12
imdb_Person "imdb_db 0..9999" --* "imdb_Person8 1..1" imdb_db : allDirectors7

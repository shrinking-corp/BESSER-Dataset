@startuml
enum CourseStatus {
  ELECTIVE
  MANDATORY
}
enum SemesterType {
  FALL
  SPRING
}
class studyplan_Course {
  + courseCode : int
  + courseName : str
  + credit : float
  + status : str
}
class studyplan_CourseGroup {
  + courseStatus : str
  + group : str
}
class studyplan_FieldOfStudy {
  + fieldName : str
}
class studyplan_Semester {
  + semesterType : str
  + year : int
}
class studyplan_Specialization {
  + specName : str
}
class studyplan_StudyPlan {
  + planName : str
}
studyplan_Course "0..1" --* "1..1" studyplan_CourseGroup : course25

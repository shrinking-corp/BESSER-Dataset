@startuml
class Admin {
  + password : str
  + userID : int
  + userName : str
}
class Login {
  + loggedinTime : str
  + loggedoutTime : str
  + userID : Profile
}
class Logout {
}
class Mail {
  + emailID : str
  + sendBy : str
  + sendTo : str
  + subject : str
}
class Payment {
  + amount : int
  + cardNumber : int
  + cardType : str
  + expiryDate : str
  + issuerName : str
}
class Profile {
  + f_Name : str
  + l_Name : str
  + password : str
  + user_Name : str
}
class SuperAdmin {
  + password : str
  + userID : int
  + userName : str
}
class Volunteer {
  + password : str
  + userID : int
  + userName : str
}
class void {
}
Admin "0..1" -- "0..9999" Mail : Admin_Mail
Admin "0..9999" -- "0..1" Payment : Admin_Payment
Mail "0..9999" -- "0..1" SuperAdmin : SuperAdmin_Mail
Payment "0..1" -- "0..9999" SuperAdmin : SuperAdmin_Payment
Payment "0..1" -- "0..9999" Volunteer : Volunteer_Payment
@enduml
@startuml
class Customer {
  + email : str
  + ident : str
  + name : str
  + phoneNumber : int
  + roomID : int
}
class Hotel {
  + city : str
  + name : str
  + phoneNumber : int
  + street : str
  + website : str
  + zip : int
}
class Room {
  + capacity : str
  + door : int
  + floor : int
  + price : float
  + roomID : int
}
Customer "1..9999" -- "0..1" Room : Customer_Room
Hotel "0..1" -- "1..9999" Room : Hotel_Room
@enduml
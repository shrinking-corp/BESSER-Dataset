@startuml
class Accessories {
  + name : str
  + price : int
}
class Admin_ {
  + ArrayList_member_ : str
  + ArrayList_worker_ : str
  + Password : str
}
class ComputerParts {
  + name : str
  + price : int
}
class Devices {
  + name : str
  + price : int
}
class Items {
  + ArrayList_ComputerParts_ : str
  + ArrayList_accessories_ : str
  + ArrayList_devices_ : str
  + typeOfItems : int
}
class Workers {
  + Designation : str
  + Password : str
  + name : str
  + salary : int
}
class customers {
  + name : str
  + shoppingCost : int
}
class member {
  + memberType : str
  + name : str
  + password : str
}
Admin_ "0..1" -- "1..1" Workers : Admin__Workers
Admin_ "0..1" -- "0..1" member : Admin__member
Devices "1..1" -- "0..1" Items : Items_Appliacne
ComputerParts "0..9999" -- "0..1" Items : Items_Furniture
Accessories "1..1" -- "0..1" Items : Items_food
@enduml
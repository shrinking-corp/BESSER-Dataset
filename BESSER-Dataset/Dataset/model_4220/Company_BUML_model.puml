@startuml
class CompanyModel_Company {
  + name : str
}
class CompanyModel_Department {
  + number : int
}
class CompanyModel_Employee {
  + isManager : bool
  + name : str
}
class CompanyModel_Product {
  + name : str
  + productID : int
}
CompanyModel_Company "1..1" *-- "0..9999" CompanyModel_Department : departments0
CompanyModel_Department "1..1" *-- "1..9999" CompanyModel_Employee : employees1
CompanyModel_Department "1..1" *-- "1..9999" CompanyModel_Product : products3
@enduml
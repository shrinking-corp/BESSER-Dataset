@startuml
class Admin {
  + password : str
  + userID : int
  + userName : str
}
class Calender_Event {
  + admin : Admin
  + category : str
  + date : str
  + description : str
  + eventType : str
  + nomarlUser : Normal_user
  + participantAmount : str
  + time : str
  + volunteer : Volunteer
}
class Login {
  + loggedinTime : str
  + loggedoutTime : str
  + userID : Profile
}
class Logout {
}
class Mail {
  + emailID : str
  + sendBy : str
  + sendTo : str
  + subject : str
}
class Manager {
  + password : str
  + userID : int
  + userName : str
}
class Normal_user {
  + password : str
  + userID : int
  + userName : str
}
class Payment {
  + amount : int
  + cardNumber : int
  + cardType : str
  + expiryDate : str
  + issuerName : str
}
class Profile {
  + f_Name : str
  + l_Name : str
  + password : str
  + user_Name : str
}
class Volunteer {
  + password : str
  + userID : int
  + userName : str
}
class void {
}
Admin "0..1" -- "0..9999" Mail : Admin_Mail
Admin "0..9999" -- "0..1" Payment : Admin_Payment
Normal_user "0..9999" -- "0..1" Payment : Normal_user_Payment
Manager "0..9999" -- "0..1" Payment : SuperAdmin_Payment
Payment "0..1" -- "0..9999" Volunteer : Volunteer_Payment
@enduml
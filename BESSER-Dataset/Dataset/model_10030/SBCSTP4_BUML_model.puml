SBCS_PumpControler "SBCS_PumpController_ClosePump 0..1" -- "SBCS_PumpControler29 1..1" SBCS_PumpController_ClosePump : PCPre28
SBCS_PumpControler "SBCS_PumpController_OpenPump 0..1" -- "SBCS_PumpControler 1..1" SBCS_PumpController_OpenPump : PCPre4

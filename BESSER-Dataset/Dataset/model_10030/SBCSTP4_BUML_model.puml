SBCS_SteamBoiler "SBCS_SteamBoiler_OpenValve2 0..1" -- "SBCS_SteamBoiler3 1..1" SBCS_SteamBoiler_OpenValve : SBPost1
SBCS_SteamBoiler "SBCS_SteamBoiler_OpenValve 0..1" -- "SBCS_SteamBoiler 1..1" SBCS_SteamBoiler_OpenValve : SBPre0
SBCS_Snapshot "SBCS_SteamBoiler9 1..1" -- "SBCS_Snapshot 1..1" SBCS_SteamBoiler : SnapshotSteamBoiler8
SBCS_ControlProgram "SBCS_SteamBoiler11 1..1" -- "SBCS_ControlProgram 1..1" SBCS_SteamBoiler : SteamBoilerControlProgram10
SBCS_Snapshot "SBCS_WaterLevelMeasurementDevice17 1..1" -- "SBCS_Snapshot16 1..1" SBCS_WaterLevelMeasurementDevice : WLMDSnapshot15
SBCS_SteamBoiler "SBCS_WaterLevelMeasurementDevice21 1..1" -- "SBCS_SteamBoiler22 1..1" SBCS_WaterLevelMeasurementDevice : WLMDSteamBoiler20

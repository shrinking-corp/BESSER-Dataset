@startuml
class classrooms {
  + number : int
  + subject : str
  + teacher : str
}
class conflictCheck {
  + conflict : bool
  + subjects : str
}
class constraints {
  + doubletons : subjects
  + singletons : subjects
}
class leftOuts {
  + classroom : classrooms
  + students : str
  + subject : subjects
  + teachers : teachers
}
class subjects {
  + Section : str
  + classroom : int
  + name : str
  + teacher : str
}
class teachers {
  + classroom : int
  + name : str
  + section : str
  + subject : str
}
@enduml
@startuml
class Hospital {
  + Cancer_Center : str
  + Cardiology : str
  + HR : str
  + Operation_Theater : str
}
class Hospital_Doctor {
  + ID : int
  + Name : str
  + Rank : str
  + Salary : int
  + Specialization : str
}
class Hospital_Patients {
  + NIC_Number : int
  + Patient_s_Name : str
  + Phone_Number : int
  + Sickness : str
}
class Hospital__Receptionist {
  + Employee_ID : int
  + Name : str
}
Hospital_Doctor "0..1" -- "1..9999" Hospital_Patients : Doctor_Patient
Hospital_Patients "1..9999" -- "1..1" Hospital__Receptionist : Patients__Receptionist
@enduml
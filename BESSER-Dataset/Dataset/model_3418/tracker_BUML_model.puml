abstract class tracker_Animal {
  + age : str
  + birthDate : str
  + breed : str
  + id : str
  + idNumber : str
  + sex : str
  + sexCode : str
  + species : str
  + speciesCode : str
  + activeTag() : str
  + addTemplate(tracker_eventTemplate : str) : void
  + allEvents() : str
}
class tracker_AnimalMissing {
}
abstract class tracker_Bovine {
}
class tracker_BovineBeef {
  + beefBreed : str
}

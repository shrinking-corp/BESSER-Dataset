@startuml
class Bill {
  + Amount : str
  + BillNo : str
  + Patient_Id : int
}
class Doctor {
  + Address : str
  + Department : str
  + DocId_ : int
  + Email : str
  + Name : str
}
class Patient {
  + Address : str
  + Age : int
  + Id : int
  + Name : str
  + PhNo_ : int
  + WardNo : int
}
class Receptionist {
  + Email : str
  + Id : int
  + Name : str
}
class Room {
  + RoomNo : int
  + RoomType : str
}
Doctor "0..1" -- "0..1" Patient : Doctor_Patient
Bill "0..1" -- "0..1" Patient : Patient_Bill
Patient "0..1" -- "0..1" Receptionist : Patient_Receptionist
Patient "0..1" -- "0..1" Room : Patient_Rooms
Bill "0..1" -- "0..1" Receptionist : Receptionist_Bill
@enduml
@startuml
class Cards {
  + Character : str
  + Suit : str
}
class Class {
}
class Deck {
  + Cards : Cards
}
class Elevens {
  + Deck : Deck
  + Player : Player
}
class Player {
  + losses : int
  + winRate : str
  + wins : int
}
Cards "0..1" -- "0..1" Deck : Deck_Cards
Deck "0..1" -- "0..1" Elevens : Elevens_Deck
Elevens "0..1" -- "1..1" Player : Elevens_Player
@enduml
@startuml
' model: conference
' project: sampleModel
' owner: User
' description: New project
enum GENDER {
  FEMALE
  MALE
  UNKNOWN
}
enum TALK_TYPE {
  CONFERENCE
  DEMONSTRATION
  WORKSHOP
}
class conference_Conference {
  + name : str
  + overview : str
  + place : str
}
class conference_Person {
  + age : int
  + eclipseCommiter : bool
  + firstname : str
  + gender : str
  + isRegistered : bool
  + lastname : str
}
class conference_Room {
  + capacity : int
  + name : str
}
class conference_Site {
  + documentation : str
  + name : str
}
class conference_Talk {
  + documentation : str
  + title : str
  + type : str
}
class conference_Topic {
  + description : str
  + documentation : str
  + references : str
}

model_Block "1..1" --* "1..1" model_OzobotProgram : block0
model_Block "1..1" --* "1..1" model_Repeat : block6
model_Block "1..1" *-- "0..9999" model_Command : commands10
model_Command "1..1" -- "1..1" model_OzobotProgram : current1
model_Command "1..1" -- "0..1" model_Transition : incoming4
model_Command "1..1" -- "0..1" model_Transition : outgoing3
model_Ozobot "1..1" *-- "0..9999" model_OzobotProgram : programs8
model_Command "1..1" -- "1..1" model_Transition : source15
model_Command "1..1" -- "1..1" model_Transition : target16
model_Block "1..1" *-- "0..9999" model_Transition : transitions13

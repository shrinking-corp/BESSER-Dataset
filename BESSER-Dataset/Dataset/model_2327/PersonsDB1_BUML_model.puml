@startuml
class pdb1_Database {
  + name : str
}
class pdb1_Person {
  + birthday : str
  + firstName : str
  + id : str
  + incrementalID : str
  + lastName : str
  + placeOfBirth : str
}
pdb1_Database "0..1" -- "1..1" pdb1_Person : database1
pdb1_Database "1..1" *-- "0..9999" pdb1_Person : persons0
@enduml
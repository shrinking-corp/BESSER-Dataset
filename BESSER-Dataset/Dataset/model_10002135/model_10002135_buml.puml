@startuml
class Blackjack {
  + cards : Cards
  + dealer : Player
  + players : str
}
class Card {
  + value_dict : str
}
class Cards {
  + color : str
  + number : str
}
class Player {
  + hand : str
  + name : str
}
Card "0..1" -- "0..1" Cards : Card_Cards
Card "0..1" -- "0..9999" Player : Card_Player
Blackjack "0..1" -- "0..1" Player : Player_Blackjack
@enduml
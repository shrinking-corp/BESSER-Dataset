@startuml
class Consulta {
  + data : str
  + pre_o : str
}
class Especialidade {
  + descricao : str
}
class Medico {
  + crm : str
  + endereco : str
  + foto : str
  + nome : str
}
class Paciente {
  + celular : str
  + endere_o : str
  + nome : str
}
Consulta "0..1" -- "0..1" Medico : Consulta_Medico
Especialidade "0..1" -- "0..1" Medico : Medico_Especialidade
Consulta "0..1" -- "0..1" Paciente : Paciente_Consulta
@enduml
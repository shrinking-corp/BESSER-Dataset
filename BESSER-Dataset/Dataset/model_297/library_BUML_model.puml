enum BookCategory {
  Biography
  Mystery
  ScienceFiction
}
class library_Book {
  + category : str
  + pages : int
  + title : str
}
class library_Library {
  + name : str
}
class library_Opinion {
  + context : str
  + text : str
}
class library_Review {
  + positive : bool
  + title : str
}
class library_Writer {
  + name : str
}

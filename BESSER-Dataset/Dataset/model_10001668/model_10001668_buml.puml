@startuml
class Customer {
  + royalty : bool
  + type : str
}
class Inventory {
  + SuperMarket : str
  + list : str
}
class Payment {
  + ID : int
  + Imtiaz : str
  + amount__ : str
  + discountamount : str
  + finalamount : str
  + list : str
  + quantity : int
  + totalamount : str
}
class Product {
  + ID : int
  + Name : str
  + amount : str
  + attribute : str
  + blgl : bool
  + price : str
  + qty : int
  + type : str
}
Customer "0..1" -- "0..1" Payment : Customer_Payment
Inventory "1..9999" -- "1..9999" Product : Inventory_Product
Inventory "1..1" -- "1..1" Payment : Payment_Inventory
Customer "0..9999" -- "0..9999" Product : Product_Customer
Payment "1..1" -- "1..9999" Product : Product_Payment
@enduml
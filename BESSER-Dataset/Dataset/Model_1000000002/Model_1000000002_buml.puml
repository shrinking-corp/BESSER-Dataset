@startuml
' model: Class_Diagram
' project: skillset_match
' owner: User
' description: New project
class Review {
  + comments : str
  + rating : int
  + reviewId : int
}
class Session {
  + duration : int
  + sessionDate : date
  + sessionId : int
  + sessionType : SessionType
}
enum SessionType {
  HYBRID
  OFFLINE
  ONLINE
}
class Skill {
  + category : str
  + description : str
  + estimatedDuration : int
  + skillId : int
  + skillLevel : TechSkillLevel
  + skillName : str
}
class SkillMatch {
  + createdDate : date
  + matchId : int
  + startDate : date
  + status : SkillMatchStatus
}
enum SkillMatchStatus {
  ACTIVE
  COMPLETED
  PENDING
  REJECTED
}
class SkillRequest {
  + createdDate : date
  + deadlineDate : date
  + requestId : int
  + status : SkillRequestStatus
}
enum SkillRequestStatus {
  CANCELLED
  COMPLETED
  MATCHED
  OPEN
}
enum TechSkillLevel {
  ADVANCED
  BEGINNER
  EXPERT
  INTERMEDIATE
  MASTERCLASS
}
class User {
  + emailId : str
  + userId : int
  + userName : str
}
class UserSkill {
  + certification : bool
  + skillId : int
  + skillLevel : UserSkillLevel
  + yearsOfExperience : int
}
enum UserSkillLevel {
  AUTHORITY
  COMPETENT
  EXPERT
  NOVICE
  PROFICIENT
}
SkillRequest "skillrequest 0..9999" -- "user_1 1..1 {not navigable}" User : creates
Session "session 0..9999" -- "skillmatch_1 1..1 {not navigable}" SkillMatch : has
SkillMatch "skillmatch_2 0..1" -- "skillrequest_1 0..9999 {not navigable}" SkillRequest : leads_to
Skill "skill 1..1" -- "userskill_1 0..9999 {not navigable}" UserSkill : refers_to
Review "review 0..1" -- "session_1 1..1 {not navigable}" Session : review
User "user 1..1 {not navigable}" -- "userskill 1..9999" UserSkill : teaches
Skill "skill_1 1..1" -- "skillrequest_2 0..9999" SkillRequest : wants
@enduml
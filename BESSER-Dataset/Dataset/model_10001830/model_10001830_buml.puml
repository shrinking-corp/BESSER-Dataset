@startuml
enum Enumeration {
}
class Event {
  + acronym : str
  + attribute : str
  + edition : int
  + id : int
  + name : str
}
class Room {
  + id : int
  + name : str
}
class Serie {
  + Events : Event
}
class Session {
  + Events : Event
  + end : str
  + id : int
  + name : str
  + room : Room
  + start : str
  + type : SessionType
}
class SessionType {
  + color : str
  + id : int
  + name : str
}
@enduml
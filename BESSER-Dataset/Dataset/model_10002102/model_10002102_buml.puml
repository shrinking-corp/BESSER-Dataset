@startuml
class Hashtag {
  + name : str
  + numOfRepeat : int
}
class Login {
  + password : str
  + username : str
}
class Message {
  + maxChars : str
}
class Page {
  + name : str
}
class Post {
  + info : str
  + privacy : str
}
class Profile {
  + password : str
  + username : str
}
class Registration {
  + fullname : str
  + password : str
  + userName : str
}
class User {
  + name : str
}
Hashtag "0..9999" -- "1..1" User : User_Hashtag
Login "1..1" -- "1..1" User : User_Login
Message "0..9999" -- "1..1" User : User_Message
Profile "1..1" -- "1..1" User : User_Myprofile
Page "0..9999" -- "1..1" User : User_Pages
Post "0..9999" -- "1..1" User : User_Post
Registration "1..1" -- "1..1" User : User_Registeration
@enduml
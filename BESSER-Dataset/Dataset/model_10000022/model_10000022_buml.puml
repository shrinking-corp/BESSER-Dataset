}
Car1 "0..1" -- "0..1" Engine : Car_Engine
Car1 "0..1" -- "0..1" Wheel : Car_Wheel
Engine "0..1" -- "0..1" Manufacturer : Engine_Manufacturer
Manufacturer "0..1" -- "0..1" Wheel : Wheel_Manufacturer

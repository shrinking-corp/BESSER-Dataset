class BankAccount {
  + balance : str
  + owner : str
}
class Book {
  + autor : str
  + name : str
  + pages : int
  + realese_date : str
}
class Car {
  + doors : int
  + engine : str
  + height : int
  + length : int
  + model : str
  + wheels : str
  + width : int
}
class Car1 {
  + doors : int
  + engine : str
  + height : int
  + length : int

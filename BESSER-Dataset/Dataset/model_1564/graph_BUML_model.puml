@startuml
class graph_Edge {
  + critical : bool
  + update(graph_criticalEdge_p : str, graph_sourceVertex_p : str, graph_targetVertex_p : str) : void
}
class graph_Graph {
  + description : str
  + name : str
  + addAdjacent(graph_critical_p : str, graph_edgeContent_p : str, graph_source_p : str, graph_target_p : str) : void
  + addEdge(graph_edge_p : str) : void
  + addNamedAdjacent(graph_critical_p : str, graph_edgeContent_p : str, graph_edgeName_p : str, graph_source_p : str, graph_target_p : str) : void
  + addVertex(graph_vertex_p : str) : void
}
abstract class graph_GraphElement {
  + name : str
}
class graph_Vertex {
  + hotSpot : bool
  + getEdgeTo(graph_vertex_p : str) : void
  + getIncomingEdgeFrom(graph_vertex_p : str) : void
  + getOutgoingEdgeTo(graph_vertex_p : str) : void
  + hasForAdjacent(graph_vertex_p : str) : bool
  + hasForIncomingAdjacent(graph_vertex_p : str) : bool
  + hasForOutgoingAdjacent(graph_vertex_p : str) : bool
}
@enduml
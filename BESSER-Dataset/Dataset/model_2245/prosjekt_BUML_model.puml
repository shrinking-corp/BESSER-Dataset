@startuml
' model: prosjekt
' project: sampleModel
' owner: User
' description: New project
class prosjekt_Course {
  + avgGrade : int
  + code : str
  + name : str
  + studyPoints : float
}
class prosjekt_CourseCoordinator {
  + name : str
}
class prosjekt_Institute {
  + name : str
  + shortName : str
}
class prosjekt_Semester {
  + name : str
}
prosjekt_Course "institute 0..1" -- "Course 1..1" prosjekt_Institute : course0
prosjekt_Course "courseCoordinator 0..1" -- "Course12 1..1" prosjekt_CourseCoordinator : course11
prosjekt_Course "semester 0..1" -- "Course10 1..1" prosjekt_Semester : course9
prosjekt_CourseCoordinator "institute2 0..9999" -- "CourseCoordinator 1..1" prosjekt_Institute : courseCoordinator1
prosjekt_Course "CourseCoordinator8 1..1" *-- "course7 0..9999" prosjekt_CourseCoordinator : courseCoordinator6
prosjekt_CourseCoordinator "Institute15 1..1" -- "courseCoordinator14 0..1" prosjekt_Institute : institute13
prosjekt_Course "Institute 1..1" *-- "course 0..1" prosjekt_Institute : institute3
prosjekt_Course "Semester 1..1" *-- "course5 0..1" prosjekt_Semester : semester4
@enduml
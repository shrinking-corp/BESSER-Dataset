@startuml
class Administrator {
  + admin_name : str
  + password : str
}
class Buyer {
  + buyer_id : str
}
class Property {
  + address : str
  + location : str
  + property_id : str
  + property_type : str
}
class Reg_User {
  + Address : str
  + password : str
  + username : str
}
class Request {
  + request_details : str
  + request_id : int
  + request_type : str
  + requser_id : str
}
class Requirement {
  + req_description : str
  + requirement_location : str
  + requirement_type : str
  + user_id : str
}
class Seller {
  + property_id : str
  + seller_id : str
}
class Unreg_User {
}
class User {
  + email : str
  + location : str
}
Buyer "1..1" -- "0..9999" Property : Property_Buyer
Property "0..9999" -- "1..1" Seller : Property_Seller
Reg_User "1..9999" -- "0..9999" Requirement : Reg_User_Requirement
Administrator "1..1" -- "1..9999" User : User_Administrator
Request "0..9999" -- "1..1" User : User_Request
@enduml
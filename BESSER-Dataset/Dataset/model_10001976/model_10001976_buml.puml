@startuml
class Airport {
  + Address : str
  + AirportID : str
  + AirportName : str
}
class Customers {
  + Email : str
  + IdCustomer : str
  + NameCustomer : str
  + Password : str
}
enum Enumeration {
}
class Flight {
  + Date : str
  + FlightNumber : str
}
class Plane {
  + Capacity : int
  + PlaneId : str
  + PlaneName : str
}
class Reservation {
}
class Routes {
  + DestinationAirport : str
  + OriginAirport : str
  + RouteID : str
}
class Seats {

  + TicketType : str
}
Customers "0..9999" -- "1..1" Reservation : Customers_Reservation
Flight "1..9999" -- "1..9999" Reservation : Flight_Reservation
Flight "1..9999" -- "1..1" Routes : Flight_Routes
Flight "1..9999" -- "1..9999" Ticket : Flight_Ticket
Flight "1..9999" -- "1..9999" Plane : Plane_Flight
Airport "1..9999" -- "1..9999" Routes : Routes_Airport
Plane "1..9999" -- "0..9999" Seats : Seats_Plane
@enduml
@startuml
class Admin {
  + Password : str
  + User_Name : Admin
  + name : str
}
class Doctor {
  + address : str
  + department : str
  + docid : int
  + name : str
  + phno : int
  + specialization : str
}
class Patient {
  + address : str
  + age : int
  + id : int
  + name : str
  + sex : str
  + telno : int
}
Admin "1..1" -- "1..9999" Doctor : Doctor_Department
Doctor "1..9999" -- "1..9999" Patient : Doctor_Patient
@enduml
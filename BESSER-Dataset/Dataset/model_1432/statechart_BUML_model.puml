@startuml
' model: scmodel
' project: sampleModel
' owner: User
' description: New project
class AbstractState {
}
enum LanguageTypes {
  groovy
  java
  relogo
}
enum MessageCheckerTypes {
  always
  conditional
  equals
  unconditional
}
enum PseudoStateTypes {
  choice
  entry
  initial
}
class State {
}
enum TriggerTypes {
  always
  condition
  exponential
  message
  probability
  timed
}
abstract class scmodel_AbstractState {
  + id : str
  + language : str
  + onEnter : str
  + onEnterImports : str
  + onExit : str
  + onExitImports : str
  + uuid : str
}
class scmodel_CompositeState {
}
class scmodel_FinalState {
}
class scmodel_History {
  + shallow : bool
}
class scmodel_PseudoState {
  + type : str
}
class scmodel_State {
}
class scmodel_StateMachine {
  + agentType : str
  + className : str
  + id : str
  + language : str
  + nextID : int
  + package : str
  + priority : float
  + uuid : str
}
class scmodel_Transition {
  + defaultTransition : bool
  + guard : str
  + guardImports : str
  + id : str
  + messageCheckerClass : str
  + messageCheckerCode : str
  + messageCheckerCodeImports : str
  + messageCheckerConditionLanguage : str
  + messageCheckerType : str
  + onTransition : str
  + onTransitionImports : str
  + outOfBranch : bool
  + priority : float
  + selfTransition : bool
  + triggerCodeLanguage : str
  + triggerConditionCode : str
  + triggerConditionCodeImports : str
  + triggerExpRateCode : str
  + triggerExpRateCodeImports : str
  + triggerProbCode : str
  + triggerProbCodeImports : str
  + triggerTime : float
  + triggerTimedCode : str
  + triggerTimedCodeImports : str
  + triggerType : str
  + uuid : str
}
AbstractState <|-- scmodel_CompositeState
AbstractState <|-- scmodel_PseudoState
AbstractState <|-- scmodel_State
State <|-- scmodel_FinalState
State <|-- scmodel_History
scmodel_AbstractState "scmodel_CompositeState 0..9999" --* "scmodel_AbstractState10 1..1" scmodel_CompositeState : children9
scmodel_AbstractState "scmodel_Transition4 1..1" -- "scmodel_AbstractState5 1..1" scmodel_Transition : from_3
scmodel_AbstractState "scmodel_StateMachine 0..9999" --* "scmodel_AbstractState 1..1" scmodel_StateMachine : states0
scmodel_AbstractState "scmodel_Transition7 1..1" -- "scmodel_AbstractState8 1..1" scmodel_Transition : to6
scmodel_StateMachine "scmodel_Transition 1..1" *-- "scmodel_StateMachine2 0..9999" scmodel_Transition : transitions1
@enduml
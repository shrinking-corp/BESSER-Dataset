@startuml
' model: fm
' project: sampleModel
' owner: User
' description: New project
enum AttributeType {
  BOOLEAN
  DOUBLE
  INTEGER
  STRING
}
enum ObjectiveFunctionType {
  MAXIMUM
  MINIMUM
  NOT_ASSIGNED
  PRODUCT
  SUM
}
class fm_Attribute {
  + alert : bool
  + comment : str
  + defaultValue : str
  + description : str
  + id : str
  + maxRangeValue : str
  + minRangeValue : str
  + minimize : bool
  + name : str
  + objectiveFunctionAggregator : str
  + qualityAttribute : bool
  + resourceAttribute : bool
  + type : str
  + weight : str
}
class fm_Constraint {
  + comment : str
  + description : str
  + language : str
  + value : str
}
class fm_EObject {
}
class fm_Feature {
  + cloneable : bool
  + comment : str
  + description : str
  + id : str
  + lower : int
  + mandatory : bool
  + name : str
  + optional : bool
  + orphan : bool
  + root : bool
  + upper : int
}
class fm_FeatureModel {
  + comment : str
  + description : str
  + name : str
  + version : str
  + getFeaturesById(fm_id : str) : void
}
class fm_Group {
  + comment : str
  + description : str
  + lower : int
  + or_ : bool
  + upper : int
  + xor : bool
}
fm_Attribute "feature 0..9999" --* "Attribute 1..1" fm_Feature : attributes12
fm_Constraint "fm_FeatureModel5 0..9999" --* "fm_Constraint 1..1" fm_FeatureModel : constraints4
fm_Attribute "Feature26 1..1" -- "attributes 1..1" fm_Feature : feature25
fm_Feature "fm_FeatureModel20 1..1" -- "fm_Feature19 0..1" fm_FeatureModel : featureModel18
fm_Constraint "fm_FeatureModel29 1..1" -- "fm_Constraint28 0..1" fm_FeatureModel : featureModel27
fm_Feature "Feature15 1..1" *-- "parentFeature 0..9999" fm_Feature : features14
fm_Feature "parentGroup 0..9999" --* "Feature24 1..1" fm_Group : features23
fm_Feature "Group17 1..1" *-- "parent 0..9999" fm_Group : groups16
fm_Feature "fm_FeatureModel2 0..9999" --* "fm_Feature3 1..1" fm_FeatureModel : orphans1
fm_Feature "groups 1..1" -- "Feature22 1..1" fm_Group : parent21
fm_EObject "fm_Feature7 0..1" -- "fm_EObject 1..1" fm_Feature : parent6
fm_Feature "Feature 1..1" -- "features 0..1" fm_Feature : parentFeature9
fm_Feature "Group 1..1" -- "features11 0..1" fm_Group : parentGroup10
fm_Feature "fm_FeatureModel 1..1" --* "fm_Feature 1..1" fm_FeatureModel : root0
@enduml
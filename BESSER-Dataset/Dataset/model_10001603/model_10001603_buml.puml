@startuml
class Chef {
  + Chef_id : int
  + Chef_name : str
  + Speciality : str
  + Status : str
  + order_id : int
}
class Customer {
  + Customer_id : int
  + Customer_name : str
  + Status : str
  + Table_id : int
  + TimeStamp : str
}
class Food {
  + Category_id : int
  + food_id : int
  + food_name : str
}
class Food_Category {
  + Category_descp : str
  + Category_id : int
  + Category_image : str
  + Category_name : str
  + sub_id : int
}
class Food_Items {
  + Food_id : int
  + Items_id : int
  + Material_id : int
  + quantity : int
}
class Food_Sub_Category {
  + sub_descp : str
  + sub_id : int
  + sub_image : str
  + sub_name : str
}
class Material {
  + Material_id : int
  + Material_name : str
  + Stock : str
  + Stock1 : str
  + Unit : str
}
class Order {
  + Order_delete : str
  + Order_edit : str
  + Order_id : int
  + Order_num : int
  + Order_status : str
}
class Table {
  + Status : str
  + Table_id : int
  + Table_num : int
}
@enduml
@startuml
class LIBRARIAN {
  + LIBRARIAN_ID : str
  + NAME : str
  + issue_book : str
  + issue_status : str
  + searchbook__ : str
  + verify_member__ : str
}
class book_mdatabase {
  + author : str
  + bookid : str
  + booktitle : str
  + update : str
}
class library {
  + _librarion_id : str
  + _location : str
}
class patron {
  + details : str
  + patronid : str
  + payfine : str
  + request : str
  + search : str
}
class patronrecord {
  + address : str
  + dateofmembership : str
  + filesowned : str
  + name : str
  + noofbooks_alooted : str
  + patronid : str
  + phone_no : str
  + type : str
}
class vendor {
  + bookdetails : str
  + paymentdetails : str
  + search : str
  + supplybooks : str
}
book_mdatabase "0..1" -- "0..1" patron : book_mdatabase_patron
LIBRARIAN "0..1" -- "0..1" library : library_LIBRARIAN
book_mdatabase "0..1" -- "0..1" library : library_book_mdatabase
patron "0..1" -- "0..1" patronrecord : patron_patronrecord
@enduml
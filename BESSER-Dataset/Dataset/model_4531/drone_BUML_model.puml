}
class drone_FlightPerformance {
  + launchType : str
  + maxAcceleration : int
  + maxAltitude : int
  + maxClimbRate : float
  + maxDescendRate : float
  + maxFlightTime : int
  + maxFlightTimeWithMaxPayload : int
  + maxOperatingTemperature : float
  + maxPayload : int
  + maxSpeed : int
  + maxTurnRate : float
  + minAcceleration : int
  + minOperatingTemperature : float
  + minSpeed : int
  + minTurnRate : float
  + positionHold : float
}
class drone_Memory {
  + size : int
  + subType : str
  + type : str
}
abstract class drone_NamedElement {
  + name : str
}
class drone_Parameter {
  + description : str
  + key : str
}
class drone_Processor {
  + architecture : str
  + frequency : int
}
class drone_Property {
  + value : str
}
class drone_ROSDriver {
  + url : str
  + version : str
}
class drone_Size {
  + height : float
  + length : float
  + propellerSize : float
  + propellers : int
  + weight : float
  + width : float
}
NamedElement <|-- drone_Action
NamedElement <|-- drone_Battery

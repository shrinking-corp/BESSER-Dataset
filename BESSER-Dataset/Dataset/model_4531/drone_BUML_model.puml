@startuml
enum LaunchType {
  HTOL
  OTHER
  VTOL
}
enum MemoryType {
  STORAGE
  VOLATILE
}
class NamedElement {
}
class drone_Action {
}
class drone_Battery {
  + capacity : int
  + cellType : str
  + rechargeTime : int
  + voltage : float
}
class drone_Device {
}
class drone_Drone {
  + accelerometer : bool
  + barometer : bool
  + communicationRange : float
  + dataRate : int

bowling_Player "playerlist 0..9999" --* "Player10 1..1" bowling_Playerlist : player9
bowling_Player "Playerlist 1..1" -- "player2 0..1" bowling_Playerlist : playerlist1
bowling_Playerlist "tournament17 0..1" -- "Playerlist18 1..1" bowling_Tournament : playerlist16

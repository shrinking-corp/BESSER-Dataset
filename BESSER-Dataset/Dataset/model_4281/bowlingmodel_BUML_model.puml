enum TournamentType {
  Amateur
  Pro
}
class bowling_Game {
  + date : date
  + frames : int
}
class bowling_Matchup {
}
class bowling_Player {
  + city : str
  + dateOfBirth : date
  + firstname : str
  + height : float
  + isProfessional : bool
  + lastname : str
  + street : str
  + streetnumber : int
}
class bowling_Playerlist {
  + name : str
}
class bowling_Tournament {
  + title : str
  + type : str
}
bowling_Game "player 0..9999" -- "Game 1..1" bowling_Player : game0

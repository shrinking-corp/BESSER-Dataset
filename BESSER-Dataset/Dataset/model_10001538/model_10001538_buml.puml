auftrag "0..1" -- "0..1" plaetzchen : auftrag_plaetzchen
auftrag "0..1" -- "0..1" backstrasse : backstrasse_auftrag
backstrasse "0..1" -- "0..1" ea_helfer : backstrasse_eaHelfer
backstrasse "0..1" -- "0..1" zutat : backstrasse_zutat
plaetzchen "0..1" -- "0..1" zutaten : plaetzchen_teig
plaetzchen "0..1" -- "0..1" zutat : plaetzchen_zutat
zutat "0..1" -- "0..1" zutaten : teig_zutat
auftrag "0..1" -- "0..1" zutat : zutat_auftrag

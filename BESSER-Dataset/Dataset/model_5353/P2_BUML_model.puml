@startuml
' model: p2
' project: sampleModel
' owner: User
' description: New project
class ModelElement {
}
enum RepositoryType {
  Artifact
  Combined
  Metadata
}
enum RequirementType {
  FEATURE
  NONE
  PROJECT
}
enum VersionSegment {
  Major
  Micro
  Minor
  Qualifier
}
class p2_Configuration {
  + arch : str
  + oS : str
  + wS : str
}
class p2_ProfileDefinition {
  + includeSourceBundles : bool
  + setRepositories(p2_repositories : str) : void
  + setRequirements(p2_requirements : str) : void
}
class p2_Repository {
  + type : str
  + uRL : str
}
class p2_RepositoryList {
  + name : str
}
class p2_Requirement {
  + filter : str
  + iD : str
  + name : str
  + namespace : str
  + optional : bool
  + type : str
  + versionRange : str
  + setVersionRange(p2_segment : str, p2_version : str) : void
}
ModelElement <|-- p2_Configuration
ModelElement <|-- p2_ProfileDefinition
ModelElement <|-- p2_Repository
ModelElement <|-- p2_RepositoryList
ModelElement <|-- p2_Requirement
p2_ProfileDefinition "p2_Repository 1..1" *-- "p2_ProfileDefinition2 0..9999" p2_Repository : repositories1
p2_Repository "p2_RepositoryList 0..9999" --* "p2_Repository4 1..1" p2_RepositoryList : repositories3
p2_ProfileDefinition "p2_Requirement 1..1" *-- "p2_ProfileDefinition 0..9999" p2_Requirement : requirements0
@enduml
class object {
}
Building "0..1" -- "0..1" Controller : Building_Controller
Building "1..1" -- "1..9999" ElevatorBay : Building_ElevatorBay
Elevator "1..9999" -- "1..1" ElevatorBay : ElevatorBay_Elevator
ElevatorBay "1..1" -- "1..9999" UpDownButton : ElevatorBay_UpDownButton

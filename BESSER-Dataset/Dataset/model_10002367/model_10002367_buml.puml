@startuml
class Customer {
  + email : str
  + ident : str
  + name : str
  + phoneNumber : int
  + surname : str
}
class Hotel {
  + city : str
  + coordinates : int
  + name : str
  + phoneNumber : int
  + street : str
  + website : str
  + zip : int
}
class Room {
  + capacity : str
  + door : int
  + floor : int
  + price : float
}
class Service {
  + basePrice : str
  + description : str
  + name : str
}
Customer "1..9999" -- "0..1" Room : Customer_Room
Hotel "0..1" -- "1..9999" Room : Hotel_Room
Hotel "0..1" -- "0..9999" Service : Service_Hotel
@enduml
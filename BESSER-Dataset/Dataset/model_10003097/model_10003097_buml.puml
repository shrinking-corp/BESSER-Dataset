@startuml
class Account {
  + email : str
  + entity : str
  + name : str
  + password : str
}
class Friend {
  + acceptornot : bool
  + friend____ : str
}
class HomePage {
  + __friendStatus : str
  + __status : str
  + likeorunlike : bool
}
class Message {
  + message : str
  + reciver : str
  + sender : str
}
class Photos {
  + __photos : str
}
class User {
  + _F : Friend
  + _P : Photos
  + __M : Message
}
Friend "0..1" -- "0..1" User : User_Friend
HomePage "0..1" -- "0..1" User : User_HomePage
Message "0..1" -- "0..1" User : User_Message
Photos "0..1" -- "0..1" User : User_Photos
@enduml
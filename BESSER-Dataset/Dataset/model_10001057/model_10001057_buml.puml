@startuml
class Agenda {
  + Introduccion : str
}
class Contacto {
  + email : str
  + nombre : str
}
class Direccion {
  + ciudad : str
  + codigo : int
  + nombre : str
  + pais : str
}
class Foto {
  + alto : int
  + ancho : int
}
class Telefono {
  + codigo : int
  + numero : int
  + prefijo : int
}
Agenda "1..1" -- "0..9999" Contacto : Agenda_Contacto
Contacto "1..1" -- "1..1" Direccion : Direccion_Contacto
Contacto "1..1" -- "1..1" Direccion : Direccion_Contacto2
Contacto "1..1" -- "1..1" Foto : Foto_Contacto
Contacto "1..1" -- "1..1" Telefono : Telefono_Contacto
Contacto "1..1" -- "1..1" Telefono : Telefono_Contacto2
@enduml
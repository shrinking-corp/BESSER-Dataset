comicBookCollection_Book "1..1" -- "0..1" comicBookCollection_Person : coverArtist13
comicBookCollection_Book "1..1" *-- "0..9999" comicBookCollection_Person : editors7
comicBookCollection_ComicBookCollection "1..1" *-- "0..9999" comicBookCollection_Publisher : publishers0
comicBookCollection_Publisher "1..1" *-- "0..9999" comicBookCollection_Series : series1

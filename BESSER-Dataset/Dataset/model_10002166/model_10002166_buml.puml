}
online_shopping_Category "1..1" -- "1..1" online_shopping_Product : Category_Product
online_shopping_Customer "1..1" -- "0..9999" online_shopping_Orders : Customer_Orders
online_shopping_Customer "1..1" -- "0..9999" online_shopping_Shopping_Card : Customer_Shopping_Card
online_shopping_Category "1..1" -- "1..1" online_shopping_Deoartment : Deoartment_Category

online_shopping_Order_Detail "0..9999" -- "1..1" online_shopping_Product : Product_Order_Detail
online_shopping_Deoartment "1..1" -- "1..1" online_shopping_Session_manager : Session_manager_Deoartment
online_shopping_Person "1..1" -- "1..1" online_shopping_Session_manager : Session_manager_Person
online_shopping_Customer "0..1" -- "0..1" online_shopping_Shopping_Card : Shopping_Card_Customer
online_shopping_Payment "1..1" -- "1..1" online_shopping_Shopping_Card : Shopping_Card_Payment

@startuml
class Login {
  + password : str
  + username : str
}
class Others {
  + discription : str
  + name : str
}
class Post {
  + info : str
  + privacy : str
}
class Profile {
  + about : str
  + password : str
  + username : str
}
class Registration {
  + fname : str
  + lname : str
  + password : secret
  + userName : str
}
class User {
  + name : str
}
class public {
  + name : str
}
class secret {
  + name : str
}
Others "0..9999" -- "1..1" User : User_Group
Profile "1..1" -- "1..1" User : User_Myprofile
Post "0..9999" -- "1..1" User : User_Post
Registration "1..1" -- "1..1" User : User_Registeration
@enduml
@startuml
class Class {
}
class Foods {
  + Catogory : Class
  + Foodname : Class
  + Ready : bool
  + price : Class
}
class Order {
  + Amount : Class
  + Orderlist : Class
  + customer_address : Class
  + customer_email : Class
  + customername : Class
  + customerphone : Class
}
class Order_management_System {
  + Orderlist : Class
}
class Reservation {
  + seats : Class
  + table : Class
}
class Staff {
  + name : Class
  + staffid : Class
}
Foods "1..9999" -- "0..1" Order : Order_Foods
Order "1..9999" -- "0..1" Reservation : Order_Reservation
Order "1..9999" -- "0..1" Order_management_System : Order_management_System_Order
Order_management_System "0..1" -- "0..1" Staff : Staff_Order_management_System
@enduml
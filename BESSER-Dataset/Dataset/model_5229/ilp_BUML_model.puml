}
class ilp_ConstraintExpression {
}
abstract class ilp_Expression {
  + comment : str
}
class ilp_IntegerLinearProgram {
}
class ilp_LiteralExpression {
  + value : str
}
class ilp_ObjectiveFunctionExpression {

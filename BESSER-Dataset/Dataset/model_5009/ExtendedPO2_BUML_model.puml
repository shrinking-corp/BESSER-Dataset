@startuml
' model: epo2
' project: sampleModel
' owner: User
' description: New project
class Address {
}
class GlobalLocation {
}
enum OrderStatus {
  BackOrder
  Complete
  Pending
}
abstract class epo2_Address {
  + country : str
  + name : str
}
class epo2_Customer {
  + customerID : int
}
class epo2_GlobalAddress {
  + location : str
}
class epo2_GlobalLocation {
  + countryCode : int
}
class epo2_Item {
  + USPrice : int
  + comment : str
  + partNum : str
  + productName : str
  + quantity : int
  + shipDate : str
}
class epo2_PurchaseOrder {
  + comment : str
  + orderDate : str
  + status : str
  + totalAmount : int
}
class epo2_Supplier {
  + name : str
}
class epo2_USAddress {
  + city : str
  + state : str
  + street : str
  + zip : int
}
Address <|-- epo2_GlobalAddress
Address <|-- epo2_USAddress
GlobalLocation <|-- epo2_GlobalAddress
epo2_Address "epo2_PurchaseOrder 1..1" --* "epo2_Address 1..1" epo2_PurchaseOrder : billTo2
epo2_Customer "orders 1..1" -- "Customer 1..1" epo2_PurchaseOrder : customer6
epo2_Customer "epo2_Supplier 0..9999" --* "epo2_Customer 1..1" epo2_Supplier : customers10
epo2_Item "order 0..9999" --* "Item 1..1" epo2_PurchaseOrder : items1
epo2_Item "PurchaseOrder 1..1" -- "items 1..1" epo2_PurchaseOrder : order0
epo2_PurchaseOrder "epo2_Supplier12 0..9999" --* "epo2_PurchaseOrder13 1..1" epo2_Supplier : orders11
epo2_Customer "PurchaseOrder21 1..1" -- "customer 0..9999" epo2_PurchaseOrder : orders20
epo2_PurchaseOrder "epo2_Supplier15 0..9999" -- "epo2_PurchaseOrder16 1..1" epo2_Supplier : pendingOrders14
epo2_PurchaseOrder "epo2_PurchaseOrder7 0..1" -- "epo2_PurchaseOrder9 1..1" epo2_PurchaseOrder : previousOrder8
epo2_Address "epo2_PurchaseOrder4 0..1" --* "epo2_Address5 1..1" epo2_PurchaseOrder : shipTo3
epo2_PurchaseOrder "epo2_Supplier18 0..9999" -- "epo2_PurchaseOrder19 1..1" epo2_Supplier : shippedOrders17
@enduml
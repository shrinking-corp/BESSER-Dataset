}
Camera "0..9999" -- "1..1" Door_Sensor : Door_Camera
HomeAutomation "0..1" -- "1..1" Smart_mirror : HomeTheatre_System
Alert "0..1" -- "0..1" Home_Security_System : Home_Security_System_Alert
Home_Security_System "1..1" -- "1..1" Smart_mirror : Home_Security_System_System
Smart_mirror "1..1" -- "1..9999" Voice_control : MicroPhone_System
Door_Sensor "1..1" -- "1..1" Sensor : Sensor_Door
Sensor "1..9999" -- "1..1" Smart_mirror : Sensor_System
Newsfeed "0..1" -- "0..1" Smart_mirror : Smart_mirror_Voice_control2
@enduml
}
class Motion_Sensor {
}
class Newsfeed {
  + Calendar : str
  + Email : str
  + News : str
  + Phone : str
  + Weather : str
}
class Sensor {
  + SensorID : int
  + SensorName : int
}
class Smart_mirror {

@startuml
' model: ppo
' project: sampleModel
' owner: User
' description: New project
class ppo_Item {
  + comment : str
  + partNum : str
  + productName : str
  + quantity : int
  + shipDate : date
  + uSPrice : int
}
class ppo_PurchaseOrder {
  + comment : str
  + orderDate : date
}
class ppo_USAddress {
  + city : str
  + country : str
  + name : str
  + state : str
  + street : str
  + zip : int
}
ppo_PurchaseOrder "ppo_USAddress 1..1" *-- "ppo_PurchaseOrder2 1..1" ppo_USAddress : billTo1
ppo_Item "ppo_PurchaseOrder 0..9999" --* "ppo_Item 1..1" ppo_PurchaseOrder : items0
ppo_PurchaseOrder "ppo_USAddress5 1..1" *-- "ppo_PurchaseOrder4 1..1" ppo_USAddress : shipTo3
@enduml
enum CourseLevel {
  HIGHER
  PHD
  THIRD_YEAR
}
enum CourseType {
  Elective
  M1A
  M2A
  Obligatory
}
enum ProgrammeType {
  BACHELOR
  INTEGRATED_MASTER
  MASTER_2_YEARS
  YEAR_STUDY
}
enum SemesterType {
  FALL
  SPRING
}
class programme_Course {
  + code : str
  + credits : float
  + level : str
  + name : str
  + taugtIn : str
}
class programme_Department {
  + name : str
}
class programme_Programme {
  + code : str
  + name : str
  + programmeType : str
}
class programme_Semester {
  + semesterType : str
}
class programme_SemesterCourse {
  + courseType : str
}
class programme_Specialization {
  + name : str
}
class programme_StudyYear {
  + year : int
}
programme_Programme "programme_Specialization 1..1" *-- "programme_Programme4 0..9999" programme_Specialization : availableSpecializations3
programme_Specialization "programme_Specialization7 0..9999" -- "programme_Specialization9 1..1" programme_Specialization : availableSpecializations8

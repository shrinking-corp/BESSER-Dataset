programme_Semester "programme_SemesterCourse 1..1" *-- "programme_Semester16 1..9999" programme_SemesterCourse : courses15
programme_Department "programme_Programme 1..1" *-- "programme_Department 0..9999" programme_Programme : programmes0
programme_Course "programme_SemesterCourse18 1..1" -- "programme_Course19 1..1" programme_SemesterCourse : semesterCourse17
programme_Semester "programme_StudyYear14 2..2" --* "programme_Semester 1..1" programme_StudyYear : semesters13

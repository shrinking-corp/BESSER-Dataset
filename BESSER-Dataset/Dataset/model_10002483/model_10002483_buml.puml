@startuml
class Booking {
  + booking_id : int
  + guest_adress : str
  + guest_id : int
  + guest_name : int
  + guestphn_no : int
  + user_id : int
}
class Hotels {
  + hotel_description : int
  + id : int
  + name : int
}
class Location {
  + attribute : str
  + loc_id : int
  + loc_name : str
}
class Owner {
  + Address : str
  + ID : int
  + Name : str
  + Phn_no_ : Owner
  + email_id : int
  + password : int
}
class Rooms {
  + checkin_date : int
  + checkout_date : int
  + id : int
  + name : str
  + price : int
  + room_description : str
}
class User {
  + Name : str
  + address : str
  + id : int
  + mail_id : str
  + password : int
  + phn_no : int
}
class occupancy {
  + booking_id : int
}
Hotels "0..1" -- "1..1" Location : City_Hotels
Hotels "0..1" -- "0..1" Owner : Hotels_Owner
Hotels "0..1" -- "0..1" Rooms : Hotels_Rooms
Booking "0..1" -- "0..1" Rooms : Rooms_Booking
Booking "0..1" -- "0..1" User : User_Booking
Booking "0..1" -- "0..1" occupancy : occupancy_Booking
@enduml
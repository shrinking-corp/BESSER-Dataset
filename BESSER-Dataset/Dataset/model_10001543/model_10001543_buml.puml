@startuml
class Deck {
  + creates_and_shuffles : card
}
class ElevensGame {
  + creates_Play_and_Deck : Deck
}
class Player {
  + has_a : card
}
class card {
  + has_a : cardFace
  + has_a1 : cardValue
}
class cardFace {
  + Club : cardFace
  + has_a : cardValue
}
class cardValue {
  + Ace : cardValue
  + Jack : cardValue
  + King : cardValue
  + Queen : cardValue
}
@enduml
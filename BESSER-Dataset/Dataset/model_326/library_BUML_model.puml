@startuml
enum BookCategory {
  Art
  Drama
  History
  SciFi
}
class library_Book {
  + category : str
  + pages : int
  + title : str
}
class library_Library {
  + address : str
  + internalRequestCount : int
  + requestCount : int
  + sumOfPages : int
}
class library_Writer {
  + name : str
}
library_Book "1..1" -- "0..9999" library_Writer : authors6

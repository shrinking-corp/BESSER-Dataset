@startuml
class ADMIN {
  + NAME : str
  + PASSWORD : str
}
class EMPLOYEE {
  + CONTACT_NO : int
  + EMAIL_ID : str
  + EMP_ID : int
  + NAME : str
  + QULIFICATION : str
}
class STUDENT {
  + CONTACT_NO : int
  + COURSE : str
  + EMAIL_ID : str
  + NAME : str
  + QUALIFICATION : str
  + STUD_ID : int
}
class VALIDATE {
  + PASSWORD : str
  + USERNAME : str
}
ADMIN "1..1" -- "0..9999" EMPLOYEE : ADMIN_EMPLOYEE
ADMIN "1..1" -- "0..9999" STUDENT : ADMIN_STUDENT
EMPLOYEE "0..9999" -- "0..9999" STUDENT : EMPLOYEE_STUDENT
@enduml
@startuml
class Doctor {
  + Shedule : str
  + Specialization : str
}
class HospitalSystem {
  + Doctors : str
  + Patients : str
  + admin : SystemAdministrator
}
class Patient {
  + Address : str
  + Age : int
  + DiseaseHistory : str
  + Phone : str
  + Prescriptions : str
}
class Person {
  + AccessLevel : str
  + BirthDate : str
  + FullName : str
  + Gender : str
  + ID : int
}
class Staff {
  + Certification : str
  + Education : str
  + Joined : str
  + Languages : str
  + Status : str
}
class SystemAdministrator {
  + Doctors : str
  + Patients : str
}
HospitalSystem "0..1" -- "0..1" SystemAdministrator : HospitalSystem_SystemAdministrator
@enduml
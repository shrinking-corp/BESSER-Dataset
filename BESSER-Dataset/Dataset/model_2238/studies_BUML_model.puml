@startuml
' model: studies
' project: sampleModel
' owner: User
' description: New project
enum SemesterCode {
  Autumn
  Spring
}
class studies_Course {
  + code : str
  + name : str
  + studyPoints : float
}
class studies_CourseInstance {
  + instanceName : str
  + semester : str
  + year : int
}
class studies_Semester {
  + studyYearSemester : str
}
class studies_Study {
  + code : str
  + name : str
}
class studies_StudyCourse {
  + mandatory : bool
}
class studies_StudyInstance {
  + year : int
}
class studies_StudyYear {
  + programName : str
}
class studies_University {
  + name : str
}
studies_Semester "studies_StudyYear14 0..1" --* "studies_Semester15 1..1" studies_StudyYear : autumnSemester13
studies_Course "courseInstances 1..1" -- "Course 1..1" studies_CourseInstance : course4
studies_CourseInstance "studies_StudyCourse 1..1" -- "studies_CourseInstance 1..1" studies_StudyCourse : courseInstance16
studies_Course "CourseInstance 1..1" *-- "course 0..9999" studies_CourseInstance : courseInstances3
studies_Course "studies_University 0..9999" --* "studies_Course 1..1" studies_University : courses0
studies_CourseInstance "studies_Semester18 1..9999" -- "studies_CourseInstance19 1..1" studies_Semester : courses17
studies_StudyYear "studies_StudyYear10 1..1" *-- "studies_StudyYear8 0..9999" studies_StudyYear : nextYear9
studies_Semester "studies_StudyYear12 0..1" --* "studies_Semester 1..1" studies_StudyYear : springSemester11
studies_StudyInstance "studies_StudyYear 1..1" *-- "studies_StudyInstance 1..1" studies_StudyYear : startYear7

Account "1..1" -- "1..1" Administrator : Account_Administrator
Account "1..1" -- "1..1" User : Account_User
Administrator "1..1" -- "0..9999" Comment : Administrator_Comment
Comment "0..9999" -- "1..1" User : User_Comment
Project "0..9999" -- "1..1" User : User_Project

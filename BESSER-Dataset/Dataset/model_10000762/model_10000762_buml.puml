@startuml
class Building {
  + Building : TKinter_Canvas
  + Elevator_list : Elevator_Elevator
  + Panel : TKinter_Canvas
  + Panel_list : Panel_Panel
}
class Elevator_Elevator {
  + Height : int
  + Velocity : int
  + Width : int
  + body : TKinter_Canvas
  + building : TKinter_Canvas
  + call_queue : Floor_Floor
  + destination : int
  + floor_list : Floor_Floor
  + gate_status : str
  + move_direction : str
  + name : int
  + people : int
  + ready : bool
}
class Floor_Floor {

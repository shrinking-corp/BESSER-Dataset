@startuml
class Card {
  + display : str
  + faceUp : bool
  + suit : int
  + value : int
}
class Deck {
  + deck : str
  + usedCards : str
}
class Player {
  + cards : str
  + type : str
  + value : str
}
Card "0..9999" -- "0..9999" Deck : Card_Deck
Card "0..9999" -- "0..9999" Player : Player_Card
@enduml
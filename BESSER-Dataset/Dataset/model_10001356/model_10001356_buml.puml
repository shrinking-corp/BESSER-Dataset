@startuml
class Bill {
  + Amount : str
  + Bill_No : str
  + Patient_Name : str
}
class Department {
  + Doctor_ID : int
  + ID : int
  + Name : str
}
class Doctor {
  + Address : str
  + Department : str
  + DocID : int
  + Name : str
  + PhNo : int
  + Specialization : str
}
class Patient {
  + Address : str
  + Age : int
  + Name : str
  + Pid : int
  + RoomNo_ : int
  + Sex : int
  + TelNO : int
}
class Receptionist {
  + Rid : str
  + Rname : str
}
class Rooms {
  + Location : str
  + Room_No : int
}
class Staff {
  + ID : int
  + Name : str
  + Type : str
}
class char_Interface {
}
Department "1..1" -- "1..1" Doctor : Doctor_Department
Doctor "0..1" -- "1..9999" Patient : Doctor_Patient
Bill "1..1" -- "1..1" Patient : Patient_Bill
Patient "1..9999" -- "1..1" Receptionist : Patient_Receptionist
Patient "1..9999" -- "1..9999" Rooms : Patient_Rooms
Bill "1..9999" -- "1..1" Receptionist : Receptionist_Bill2
Rooms "1..9999" -- "1..9999" Staff : Rooms_Staff
@enduml
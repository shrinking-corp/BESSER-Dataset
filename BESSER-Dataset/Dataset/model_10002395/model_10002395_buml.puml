@startuml
class Places {
  + ID : int
  + address : str
  + music : str
  + opening_times : date
  + place_id : str
  + plugs : str
  + review_count : int
  + wifi : str
}
class Reviews {
  + ID : int
  + business_id : int
  + date : date
  + rating : int
  + text : str
  + user_id : int
}
class Users {
  + ID : int
  + average_star : int
  + date_joined : date
  + name : str
  + review_count : int
}
@enduml
@startuml
' model: bowling
' project: sampleModel
' owner: User
' description: New project
enum TournamentType {
  Amateur
  Pro
}
class bowling_Game {
  + frames : int
}
class bowling_League {
  + name : str
}
class bowling_Matchup {
  + date : date
}
class bowling_Player {
  + dateOfBirth : date
  + eMail : str
  + height : float
  + isAvailable : bool
  + isProfessional : bool
  + name : str
  + notes : str
  + street : str
  + streetNumber : int
  + telephon : str
  + hasCorrectStreetNumber(bowling_context : str, bowling_diagnosticianChain : str) : bool
  + hasDateOfBirth(bowling_context : str, bowling_diagnosticianChain : str) : bool
  + hasGame(bowling_context : str, bowling_diagnosticianChain : str) : bool
  + hasHeight(bowling_context : str, bowling_diagnosticianChain : str) : bool
  + hasIsAvailable(bowling_context : str, bowling_diagnosticianChain : str) : bool
  + hasName(bowling_context : str, bowling_diagnosticianChain : str) : bool
  + hasNotes(bowling_context : str, bowling_diagnosticianChain : str) : bool
  + hasStreet(bowling_context : str, bowling_diagnosticianChain : str) : bool
  + hasTelephon(bowling_context : str, bowling_diagnosticianChain : str) : bool
}
class bowling_Tournament {
  + title : str
  + type : str
  + hasLeague(bowling_context : str, bowling_diagnosticianChain : str) : bool
  + hasTounamentPro(bowling_context : str, bowling_diagnosticianChain : str) : bool
}
bowling_Game "player 0..9999" -- "Game 1..1" bowling_Player : games0
bowling_Game "matchup 0..2" --* "Game7 1..1" bowling_Matchup : games6
bowling_League "bowling_Tournament4 0..1" -- "bowling_League5 1..1" bowling_Tournament : league3
bowling_Game "Matchup 1..1" -- "games 1..1" bowling_Matchup : matchup8
bowling_Matchup "bowling_Tournament 0..9999" --* "bowling_Matchup 1..1" bowling_Tournament : matchups2
bowling_Game "Player 1..1" -- "games10 0..1" bowling_Player : player9
bowling_League "bowling_Player 1..1" *-- "bowling_League 0..9999" bowling_Player : players1
@enduml
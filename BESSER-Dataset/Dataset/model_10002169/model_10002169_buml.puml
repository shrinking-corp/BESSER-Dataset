@startuml
class Alert {
  + AlertID : int
}
class End_Of_Day {
  + EOT : int
}
class Home_Security_System {
  + UserID : int
}
class HouseHolds {
  + LampLight : str
  + TimeID : str
}
class Lamp {
  + LampID : int
}
class MicroPhone {
  + MicID : str
}
class Relay {
  + SensorID : int
  + SensorType : int
}
class Start_Of_Day {
  + SOT : int
}
class System {
  + Status : bool
  + Update : float
}
Alert "0..1" -- "0..1" Home_Security_System : Home_Security_System_Alert
Home_Security_System "1..1" -- "1..1" System : Home_Security_System_System
End_Of_Day "0..1" -- "0..1" HouseHolds : HouseHolds_End_Of_Day
HouseHolds "0..1" -- "0..1" Start_Of_Day : HouseHolds_Start_Of_Day
MicroPhone "1..9999" -- "1..1" System : MicroPhone_System
Lamp "1..1" -- "1..1" Relay : Sensor_Door
Relay "1..9999" -- "1..1" System : Sensor_System
HouseHolds "0..1" -- "1..1" System : System_HouseHolds
@enduml
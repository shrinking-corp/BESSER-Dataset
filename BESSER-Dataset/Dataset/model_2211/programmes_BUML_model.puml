enum Access {
  M1A
  M2A
  NA
  O
  VA
}
enum SemesterSeason {
  Fall
  Spring
}
class StudyProgrammes_Course {
  + availableSemesters : str
  + code : str
  + credits : float
  + name : str
}
class StudyProgrammes_CourseAccess {
  + access : str
}
class StudyProgrammes_Department {
  + name : str
}
class StudyProgrammes_Programme {
  + code : str
  + name : str
  + semestersBeforeSpecialization : int
  + startYear : int
  + totalNumberOfSemesters : int
}
class StudyProgrammes_Semester {
  + code : str
  + semesterSeason : str
  + year : int
}
class StudyProgrammes_Specialization {
  + lengthInSemesters : int
  + name : str
  + startSemester : int
}

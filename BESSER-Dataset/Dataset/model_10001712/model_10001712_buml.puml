@startuml
class CargoTrain {
  + Containers : str
  + Origin : str
  + Stops : str
}
class Coach {
  + numberOfSeats : int
  + seatsFilled : int
}
class FirstClass {
  + numberOfSeats : int
  + seatsFilled : int
}
class PassengerTrain {
  + Origin : str
  + Stops : str
  + numberOfPassengers : int
}
class Train {
  + Cars : str
  + Manufacturer : str
  + Operator : str
  + Power : str
}
@enduml
@startuml
class Bank {
  + name : str
}
class BankAccount {
  + accountHolder : str
  + accountNumber : int
  + balance : float
}
class FixedAccount {
  + chequeBookNo : str
}
class SavingsAccount {
  + interestRate : float
  + noticeGiven : bool
}
Bank "1..1" -- "0..9999" BankAccount : Bank_BankAccount
@enduml
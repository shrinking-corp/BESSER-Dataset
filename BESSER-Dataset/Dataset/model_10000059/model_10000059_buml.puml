  + UserLevel : int
  + UserName : str
}
class BookingController {
  + BookingID : int
  + CustomerName : str
  + Date : str
  + Phone : str
  + TableNo : str
  + Time : str
}
class Login {
  + Discount : int
  + LoyaltyID : int
}
class Membership_Card {
  + Discount : int
  + LoyaltyID : int
}
class OrderController {
  + Date : str
  + OrderID : int
  + OrderTotal : str
  + UserID : int
}
class Table {

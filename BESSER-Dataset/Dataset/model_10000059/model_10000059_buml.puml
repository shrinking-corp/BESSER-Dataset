OrderController "1..1" -- "1..1" Table : Order_Table
BookingController "1..1" -- "1..9999" Table : Table_Booking
AdminController "0..1" -- "0..1" processQuery : processQuery_AdminPanel
BookingController "0..1" -- "0..1" processQuery : processQuery_Booking

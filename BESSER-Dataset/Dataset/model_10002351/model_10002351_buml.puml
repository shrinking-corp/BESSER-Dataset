@startuml
class It {
  + password : str
}
class Patient {
  + _doc : doctor
  + _nur : nurse
  + id : str
  + illness : str
}
class Person {
  + age : int
  + name : str
}
class Receptionist {
}
class Room {
  + available : bool
  + capasittity : int
  + num : int
  + patients : str
  + room_type : str
}
class appointment {
  + day : int
  + duration : int
  + hour : int
  + minute : int
}
class doctor {
  + patient : str
  + weekappointment : str
}
class employee {
  + Salary : int
  + department : str
  + id : str
  + password : str
}
class nurse {
  + _rom : Room
}
Patient "0..1" -- "0..1" doctor : Patient__doctor
Patient "0..1" -- "0..1" Room : Room__Patient
Room "0..1" -- "0..1" nurse : nurse_Room
@enduml
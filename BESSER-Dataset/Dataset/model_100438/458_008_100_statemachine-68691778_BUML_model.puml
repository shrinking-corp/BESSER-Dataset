abstract class statemachine_Set {
}
class statemachine_State {
  + initial : bool
  + terminal : bool
}
class statemachine_StateMachine {
  + accept(statemachine_word : str) : bool
  + accessibleAndCoAccessibleStates() : void
  + accessibleStates(statemachine_st : str) : void
  + addState(statemachine_initial : str, statemachine_terminal : str) : str
  + addTransition(statemachine_transition : str) : void
  + alphabet() : void
  + coAccessibleStates() : void
  + delta(statemachine_s : str) : void
  + deltaFrom(statemachine_from_ : str, statemachine_to : str) : void
  + deltaMinusOne(statemachine_st : str) : void
  + initials() : void
  + step(statemachine_o : str, statemachine_s : str) : void
  + steps(statemachine_st : str, statemachine_word : str) : void
  + terminals() : void
}
class statemachine_Transition {
  + label : str
}
statemachine_StateMachine "statemachine_Transition 1..1" *-- "statemachine_StateMachine2 0..9999" statemachine_Transition : delta1
statemachine_State "statemachine_Transition7 1..1" -- "statemachine_State8 1..1" statemachine_Transition : end6
statemachine_State "statemachine_Transition4 1..1" -- "statemachine_State5 1..1" statemachine_Transition : start3

@startuml
class Card {
  + suit : int
  + value : int
}
class Deck {
  + Card__ : Card
  + numOfCards : int
}
class Stack {
  + cards__ : Card
  + numOfCards : int
}
Card "0..1" -- "0..1" Deck : Card_Deck
Card "0..1" -- "0..1" Stack : Card_Stack
Deck "0..1" -- "0..1" Stack : Deck_Stack
Stack "0..1" -- "0..1" Stack : Stack_Stack
@enduml
class Order {
  + Customer : Person
  + Date : str
  + OrderID : int
  + items : Shopping_cart
}
class Person {
  + Address : str
  + Email : str
  + Name : str
  + Surname : str
}
class Product {
  + ProductID : int
  + description : str
  + name : str
  + price : int
  + quantity : int
}
class Shopping_cart {
  + Products : str
}
class Stock {
  + Items : str
}
class User {
  + Password : str
  + UserID : int
  + UserName : str
}

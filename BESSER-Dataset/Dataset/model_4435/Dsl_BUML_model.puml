  + nrOfTimes : int
  + time : int
}
class dsl_TouchSensor {
  + key : str
}
class dsl_UltrasonicSensor {
  + comparator : str
  + distance : str
}
class dsl_timeUnitValue {
  + unit : str
}
enum timeUnit {
  MILISECONDS
  SECONDS
}
SensorType <|-- dsl_ColorSensor
SensorType <|-- dsl_TouchSensor
SensorType <|-- dsl_UltrasonicSensor
dsl_Ignorables "0..1" --* "1..1" dsl_Task : ignoreBehavior3
dsl_ColorSensor "1..1" *-- "0..1" dsl_ColorValue : key7
dsl_ColorSensor "1..1" *-- "0..9999" dsl_ColorValue : keys8
dsl_SensorType "0..1" --* "1..1" dsl_Task : sensor1
dsl_Mission "1..1" *-- "0..9999" dsl_Task : tasks0
dsl_Task "1..1" *-- "0..1" dsl_timeUnitValue : timeunit5
@enduml
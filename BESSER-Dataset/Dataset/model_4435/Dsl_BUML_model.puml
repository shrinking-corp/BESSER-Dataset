  DRIVE_BACKWARD
  DRIVE_FORWARD
  MEASURE
  ROTATE_L
  ROTATE_R
  STOP_DRIVING
  TURN_AROUND
}
enum Colors {
  BLACK
  BLUE
  CYAN
  DARK_GRAY
  GRAY
  GREEN
  LIGHT_GRAY
  MAGENTA
  ORANGE
  PINK
  RED
  WHITE
  YELLOW
}
enum CompareOperator {
  EQ
  G
  GEQ
  L
  LEQ
  NEQ
}
enum Directions {
  E
  N
  NE
  NW
  S
  SE
  SW
  W
}
class SensorType {
}
enum TouchSensorSides {
  ANY
  BOTH
  LEFT
  RIGHT
}
class dsl_ColorSensor {
  + distinct : bool
}
class dsl_ColorValue {
  + color : str
}
class dsl_Ignorables {
  + AVOID_OBJECTS : str
}
class dsl_Mission {
}
class dsl_SensorType {
}
class dsl_Task {
  + action : str

@startuml
class Booking {
  + booking_Id : str
  + contact : str
  + date : str
  + name : str
  + reservedTables : str
  + type : int
}
class Chef {
}
class Food {
  + description : str
  + food_Id : str
  + name : str
  + prepared : bool
  + price : str
  + served : bool
  + type : int
}
class Manager {
}
class Order {
  + foodOrdered : Food
  + order_Id : str
}
class RMS {
  + bookings : str
}
class Report {
  + orders : str
  + profit : str
  + totalSales : str
}
class Staff {
  + TrabalhoTipo : int

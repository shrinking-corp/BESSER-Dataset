  + table_Id : str
}
class Waiter {
}
Food "1..9999" -- "0..9999" Order : Order_Food
Order "1..1" -- "1..1" Table : Order_Table
Booking "0..9999" -- "1..1" RMS : RMS_Booking
RMS "1..1" -- "1..9999" Report : Report_RMS
RMS "1..1" -- "0..9999" Staff : Staff_RMS
Booking "1..1" -- "1..9999" Table : Table_Booking
@enduml
@startuml
class Cellule {
  + model : ModelTraint
}
class Controleur {
  + modeletrain : ModelTraint
  + vue : Vue
}
class Interieur {
  + InnumeroWagon : int
}
class Joueur {
  + a_b : int
  + attribute : str
  + model : ModelTraint
  + nomJoueur : str
  + positionBandit : Position
  + x_y : int
}
class ModelTraint {
  + cellule____ : Cellule
  + indiceJoueurCourant : int
  + indiceWagonCourant : int
  + joueurs__ : Joueur
  + listeWagon__ : Wagon
  + nombreJoueur : int
  + nombreWagon : int
}
abstract class Observable {
  + listObservers__ : str
}
class Obsever_Interface {
}
class Position {
  + numeroWagon : int
}
class Toit {
  + IntNumereoWagon : int
}
class Vue {
  + modeltrain : ModelTraint
}
class Wagon {
  + ListedesButin__ : str
  + listeDesBandit : Joueur
  + modele : ModelTraint
  + numeroWagon : int
}
Cellule "1..1" -- "1..1" ModelTraint : Cellule_ModelTrant
Controleur "1..1" -- "1..1" Vue : Controleur_Vue
Joueur "0..9999" -- "1..1" ModelTraint : ModelTrant_Joueur
ModelTraint "0..9999" -- "0..9999" Wagon : ModelTrant_Wagon
@enduml
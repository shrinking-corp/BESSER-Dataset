@startuml
enum BookCategory {
  Biography
  Mystery
  ScienceFiction
}
class cascadenotall_Book {
  + category : str
  + pages : str
  + title : str
}
class cascadenotall_Library {
  + name : str
}
class cascadenotall_Writer {
  + name : str
}
cascadenotall_Book "1..1" -- "1..1" cascadenotall_Writer : author0
cascadenotall_Book "0..9999" --* "1..1" cascadenotall_Library : books2
cascadenotall_Book "0..9999" -- "1..1" cascadenotall_Writer : books4
cascadenotall_Library "1..1" *-- "0..9999" cascadenotall_Writer : writers1
@enduml
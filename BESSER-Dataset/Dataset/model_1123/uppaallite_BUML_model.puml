@startuml
class uppaallite_LocationType {
  + committed : bool
  + cost : str
  + id : str
  + initial : bool
  + invariant : str
  + name : str
  + urgent : bool
  + x : int
  + y : int
}
class uppaallite_TemplateType {
  + declaration : str
  + name : str
}
class uppaallite_TransitionType {
  + assignment : str
  + cost : str
  + guard : str
  + sync : str
}
class uppaallite_UppaalDiagram {
  + declaration : str
  + resourceWeightDeclaration : str
}

@startuml
class feature_Attribute {
  + name : str
  + type : str
  + value : str
}
class feature_Constraint {
  + expression : str
  + language : str
}
class feature_Feature {
  + maxCardinality : int
  + minCardinality : int
  + name : str
  + isMandatory() : bool
}
class feature_FeatureModel {
  + name : str
  + getAllFeatures() : str
  + getMandatoryFeatures() : str
}
class feature_Group {
  + maxCardinality : int
  + minCardinality : int
}
feature_Attribute "0..9999" --* "1..1" feature_Feature : attributes8
feature_Feature "1..9999" --* "1..1" feature_Group : childFeatures13
feature_FeatureModel "1..1" *-- "0..9999" feature_FeatureModel : children4
feature_Constraint "0..9999" --* "1..1" feature_FeatureModel : constraints0
feature_Attribute "1..1" -- "1..1" feature_Feature : feature15
feature_Feature "1..1" *-- "0..9999" feature_Group : groups9
feature_FeatureModel "1..1" -- "0..1" feature_FeatureModel : parent6
feature_Feature "1..1" -- "1..1" feature_Group : parentFeature12
feature_Feature "1..1" -- "0..1" feature_Group : parentGroup10
feature_Feature "0..1" --* "1..1" feature_FeatureModel : root1
@enduml
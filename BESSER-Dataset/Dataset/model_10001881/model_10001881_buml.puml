@startuml
class Account {
  + billingAddress : str
  + closed : date
  + isClosed : bool
  + open : date
}
class Customer {
  + address : str
  + email : str
  + phone : str
}
class LineItem {
  + price : float
  + quantity : int
}
enum OrderStatus {
}
class Order_Compute_Price {
  + number : int
  + ordered : date
  + shipTo : str
  + shipped : bool
  + status : OrderStatus
  + total : float
}
class Payment {
  + details : str
  + paidDate : date
  + total : float
}
class Product {
  + description : str
  + name : str
}
class ShoppinCart {
  + creationDate : date
}
enum UserState {
}
Account "1..1" -- "0..9999" Order_Compute_Price : Account_Order
Account "1..1" -- "0..9999" Payment : Account_Payment
Account "1..1" -- "1..1" ShoppinCart : Account_ShoppinCart
Account "1..1" -- "1..1" Customer : Customer_Account
LineItem "1..9999" -- "0..9999" Order_Compute_Price : Order_LineItem
Order_Compute_Price "1..1" -- "0..9999" Payment : Payment_Order
LineItem "0..9999" -- "1..1" Product : Product_LineItem
LineItem "0..9999" -- "1..1" ShoppinCart : ShoppinCart_LineItem
@enduml
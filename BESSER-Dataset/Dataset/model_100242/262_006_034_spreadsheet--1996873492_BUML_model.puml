spreadsheet_Cell "1..1" -- "1..1" spreadsheet_Column : Column22
spreadsheet_Column "0..9999" --* "1..1" spreadsheet_Sheet : Column3
spreadsheet_Row "0..9999" --* "1..1" spreadsheet_Sheet : Row1
spreadsheet_Cell "1..1" -- "1..1" spreadsheet_Row : Row19
spreadsheet_Sheet "0..9999" --* "1..1" spreadsheet_Spreadsheet : Sheet0
spreadsheet_Row "1..1" -- "1..1" spreadsheet_Sheet : Sheet10
spreadsheet_Column "1..1" -- "1..1" spreadsheet_Sheet : Sheet16
spreadsheet_Sheet "1..1" -- "0..1" spreadsheet_Spreadsheet : Spreadsheet5
@enduml
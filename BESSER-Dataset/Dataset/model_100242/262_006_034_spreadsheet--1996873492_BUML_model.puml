@startuml
' model: spreadsheet
' project: sampleModel
' owner: User
' description: New project
enum CellType {
  CellTypeDate
  CellTypeFormula
  CellTypeNumeric
  CellTypeString
}
class spreadsheet_Cell {
  + CellType : str
  + DoubleValue : float
  + StringValue : str
  + ValueFormatted : str
}
class spreadsheet_Column {
  + ColumnIndex : int
  + getCell(spreadsheet_row : str) : str
}
class spreadsheet_Row {
  + RowIndex : int
  + getCell(spreadsheet_columnindex : str) : str
}
class spreadsheet_Sheet {
  + SheetIndex : int
  + SheetName : str
  + getColumn(spreadsheet_columnindex : str) : str
  + getRow(spreadsheet_rowindex : str) : str
}
abstract class spreadsheet_Spreadsheet {
  + FilePath : str
  + Label : str
  + getSheet(spreadsheet_sheetname : str) : str
  + readFile() : void
  + writeFile() : void
}
spreadsheet_Cell "Column14 0..9999" -- "Cell15 1..1" spreadsheet_Column : Cell13
spreadsheet_Cell "Row9 0..9999" --* "Cell 1..1" spreadsheet_Row : Cell8
spreadsheet_Cell "Column24 1..1" -- "Cell23 1..1" spreadsheet_Column : Column22
spreadsheet_Column "Sheet4 0..9999" --* "Column 1..1" spreadsheet_Sheet : Column3
spreadsheet_Row "Sheet2 0..9999" --* "Row 1..1" spreadsheet_Sheet : Row1
spreadsheet_Cell "Row21 1..1" -- "Cell20 1..1" spreadsheet_Row : Row19
spreadsheet_Sheet "Spreadsheet 0..9999" --* "Sheet 1..1" spreadsheet_Spreadsheet : Sheet0
spreadsheet_Row "Sheet12 1..1" -- "Row11 1..1" spreadsheet_Sheet : Sheet10
spreadsheet_Column "Sheet18 1..1" -- "Column17 1..1" spreadsheet_Sheet : Sheet16
spreadsheet_Sheet "Spreadsheet7 1..1" -- "Sheet6 0..1" spreadsheet_Spreadsheet : Spreadsheet5
@enduml
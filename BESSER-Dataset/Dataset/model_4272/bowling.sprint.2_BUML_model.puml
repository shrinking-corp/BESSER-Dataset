@startuml
enum TournamentType {
  Amateur
  Pro
}
class bowling_Alley {
  + name : str
}
class bowling_Game {
  + frames : int
}
class bowling_Lane {
  + number : int
}
class bowling_League {
  + name : str
}
class bowling_Matchup {
  + name : str
}
class bowling_Player {
  + dateOfBirth : date
  + height : float
  + isProfessional : bool
  + name : str
}
class bowling_Tournament {
  + name : str
  + type : str
}

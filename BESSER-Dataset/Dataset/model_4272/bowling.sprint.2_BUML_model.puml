@startuml
' model: bowling
' project: sampleModel
' owner: User
' description: New project
enum TournamentType {
  Amateur
  Pro
}
class bowling_Alley {
  + name : str
}
class bowling_Game {
  + frames : int
}
class bowling_Lane {
  + number : int
}
class bowling_League {
  + name : str
}
class bowling_Matchup {
  + name : str
}
class bowling_Player {
  + dateOfBirth : date
  + height : float
  + isProfessional : bool
  + name : str
}
class bowling_Tournament {
  + name : str
  + type : str
}
bowling_Game "matchup 2..2" --* "Game 1..1" bowling_Matchup : games2
bowling_Alley "bowling_Lane 1..1" -- "bowling_Alley12 0..9999" bowling_Lane : lanes11
bowling_Alley "bowling_League7 1..1" -- "bowling_Alley 0..9999" bowling_League : leagues6
bowling_Game "Matchup 1..1" -- "games 1..1" bowling_Matchup : matchup3
bowling_Matchup "bowling_Tournament 0..9999" --* "bowling_Matchup 1..1" bowling_Tournament : matchups1
bowling_Game "bowling_Player5 1..1" -- "bowling_Game 0..1" bowling_Player : player4
bowling_League "bowling_Player 1..1" *-- "bowling_League 0..9999" bowling_Player : players0
bowling_Alley "bowling_Tournament10 1..1" -- "bowling_Alley9 0..9999" bowling_Tournament : tournaments8
@enduml
@startuml
class shop_Customer {
  + address : str
  + comments : str
  + familyName : str
  + hotel : str
  + surname : str
  + telephoneNr : str
}
class shop_Order {
  + comments : str
  + number : str
}
class shop_PriceCategory {
  + name : str
  + prices : float
}
class shop_Product {
  + description : str
  + name : str
  + number : str
}
class shop_ProductCategory {
  + name : str
}
class shop_Transaction {
  + endDate : date
  + number : str
  + paidDate : date
  + price : float
  + startDate : date
}

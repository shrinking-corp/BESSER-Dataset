shop_PriceCategory "0..1" -- "1..1" shop_Product : priceCategory1
shop_Product "0..1" -- "1..1" shop_Transaction : product12
shop_Product "1..1" -- "0..1" shop_ProductCategory : productCategory0
shop_Product "0..9999" --* "1..1" shop_ProductCategory : products2
shop_ProductCategory "1..1" *-- "0..9999" shop_ProductCategory : subCategorys4

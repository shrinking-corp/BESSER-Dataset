@startuml
class ATM {
  + location : str
  + managedby : str
}
class Account {
  + balance : int
  + number : int
}
class Bank {
  + address : str
  + code : int
}
class Customer {
  + address : str
  + cardnumber : int
  + dob : str
  + name : str
  + pin : int
}
ATM "0..1" -- "0..1" Bank : Bank_ATM
Account "0..1" -- "0..1" Bank : Bank_Account
Account "0..1" -- "0..1" Customer : Customer_Account
@enduml
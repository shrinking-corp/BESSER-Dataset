@startuml
class Admin_ {
  + ArrayList_member_ : str
  + ArrayList_worker_ : str
  + Password : str
}
class Appliacne {
  + name : str
  + price : int
}
class Furniture {
  + name : str
  + price : int
}
class Items {
  + ArrayList_appliance_ : str
  + ArrayList_food_ : str
  + ArrayList_furniture_ : str
  + typeOfItems : int
}
class Workers {
  + Designation : str
  + Password : str
  + name : str
  + salary : int
}
class customers {
  + name : str
  + shoppingCost : int
}
class food {
  + name : str
  + price : int
}
class member {
  + memberType : str
  + name : str
  + password : str
}
Admin_ "0..1" -- "1..1" Workers : Admin__Workers
Admin_ "0..1" -- "0..1" member : Admin__member
Appliacne "1..1" -- "0..1" Items : Items_Appliacne
Furniture "0..9999" -- "0..1" Items : Items_Furniture
Items "0..1" -- "1..1" food : Items_food
@enduml
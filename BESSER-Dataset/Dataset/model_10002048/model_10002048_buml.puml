@startuml
class Administrator {
  + Name : str
  + adminID : str
}
class Customer {
  + Address : str
  + ContactNo : str
  + CusID : int
  + Email : str
  + Name : str
}
class Doctor {
  + ContactNo : str
  + DoctorID : int
  + Email : str
  + Name : str
}
class Employee {
  + ContactNo : str
  + Department : str
  + EmpID : int
  + Name : str
}
class Manager {
  + ContatctNo : str
  + Email : str
  + ManagerID : int
  + Name : str
}
class Order {
  + CusID : int
  + DateCreated : str
  + OrderID : int
}
class Payment {
  + Method : str
  + OrderID : int
  + PaymentID : int
}
class Pets {
  + Age : int
  + PetID : int
  + PetName : str
  + PetType : str
}
class Shopping_Cart {
  + CartID : int
  + OrderID : int
  + Quantity : int
}
class User {
  + Password : str
  + UserID : str
}
Customer "0..1" -- "0..9999" Order : Customer_OrderPet
Order "1..1" -- "1..9999" Payment : Order_Payment
Order "1..1" -- "0..9999" Shopping_Cart : Order_Shopping_Cart
@enduml
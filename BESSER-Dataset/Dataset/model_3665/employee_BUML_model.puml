@startuml
enum Gender {
  Female
  Male
}
class Project {
}
class employee_Address {
  + city : str
  + country : str
  + id : int
  + postalCode : str
  + province : str
  + street : str
}
class employee_Degree {
  + name : str
}
class employee_EmailAddress {
  + address : str
  + id : int
  + name : str
}
class employee_Employee {
  + firstName : str
  + gender : str
  + lastName : str
  + responsibilities : str
  + salary : float
  + version : str
}
class employee_EmploymentPeriod {
  + endDate : date

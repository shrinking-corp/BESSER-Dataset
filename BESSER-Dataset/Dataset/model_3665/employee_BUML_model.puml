@startuml
' model: employee
' project: sampleModel
' owner: User
' description: New project
enum Gender {
  Female
  Male
}
class Project {
}
class employee_Address {
  + city : str
  + country : str
  + id : int
  + postalCode : str
  + province : str
  + street : str
}
class employee_Degree {
  + name : str
}
class employee_EmailAddress {
  + address : str
  + id : int
  + name : str
}
class employee_Employee {
  + firstName : str
  + gender : str
  + lastName : str
  + responsibilities : str
  + salary : float
  + version : str
}
class employee_EmploymentPeriod {
  + endDate : date
  + id : int
  + startDate : date
}
class employee_JobTitle {
  + title : str
}
class employee_LargeProject {
  + budget : float
  + milestone : date
}
class employee_PhoneNumber {
  + areaCode : str
  + number : str
  + type : str
}
abstract class employee_Project {
  + description : str
  + name : str
}
class employee_SmallProject {
}
Project <|-- employee_LargeProject
Project <|-- employee_SmallProject
employee_Address "employee_Employee5 0..1" --* "employee_Address 1..1" employee_Employee : address4
employee_Degree "employee_Employee16 0..9999" -- "employee_Degree 1..1" employee_Employee : degrees15
employee_EmailAddress "employee_Employee21 0..9999" --* "employee_EmailAddress 1..1" employee_Employee : emailAddresses20
employee_Employee "employee_JobTitle 1..1" -- "employee_Employee7 0..1" employee_JobTitle : jobTitle6
employee_Employee "Employee13 1..1" -- "manager 0..9999" employee_Employee : managedEmployees12
employee_Employee "Employee10 1..1" -- "managedEmployees 0..1" employee_Employee : manager9
employee_Employee "phoneNumbers 1..1" -- "Employee 1..1" employee_PhoneNumber : owner1
employee_Employee "employee_EmploymentPeriod 1..1" *-- "employee_Employee3 0..1" employee_EmploymentPeriod : period2
employee_Employee "PhoneNumber 1..1" *-- "owner 0..9999" employee_PhoneNumber : phoneNumbers14

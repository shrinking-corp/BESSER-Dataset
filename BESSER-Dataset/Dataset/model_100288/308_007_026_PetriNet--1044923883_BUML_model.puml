@startuml
enum ArcKind {
  normal
  read_arc
}
class Node {
}
class petriNet_Arc {
  + kind : str
  + weight : int
}
abstract class petriNet_Node {
  + name : str
}
class petriNet_PetriNet {
  + name : str
}
class petriNet_Place {
  + marking : int
}
class petriNet_Transition {
  + max_time : int

@startuml
class Entrenador {
  + a_os_de_experiencia : int
  + nivel_de_acreditaci_n : str
}
class Equipo {
  + nombre : str
  + registro : str
}
class Jugadores {
  + nombre : str
  + posicion : int
}
class Liga {
  + datos_comienzo : str
  + datos_finalizaci_n : str
  + nombre : str
}
class Partido {
  + localizaci_n : str
  + resultado : int
}
class Personas {
  + Direccion : str
  + Nombre : str
}
Equipo "1..1" -- "0..1" Jugadores : Equipo_Jugadores
Equipo "0..9999" -- "1..9999" Partido : Equipo_Partido
Equipo "1..1" -- "1..1" Jugadores : Jugadores_Equipo
Equipo "0..1" -- "1..1" Liga : Liga_Equipo
@enduml
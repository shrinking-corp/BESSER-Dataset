Candidat "1..9999" -- "1..1" Groupe : candidat_groupe
Candidat "1..1" -- "0..9999" CoursConduite : coursConduite_candidat
CoursConduite "0..9999" -- "1..1" Voiture : coursConduite_voiture
CoursCode "1..9999" -- "1..1" Groupe : groupe_coursCode
CoursCode "0..9999" -- "1..1" Professeur : professeur_coursCode
CoursConduite "0..9999" -- "1..1" Professeur : professeur_coursConduite

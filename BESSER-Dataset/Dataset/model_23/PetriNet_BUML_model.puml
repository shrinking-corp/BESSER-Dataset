PetriNet_Node "1..1" -- "1..1" PetriNet_PetriNet : net3
PetriNet_Node "0..9999" --* "1..1" PetriNet_PetriNet : nodes0
PetriNet_Arc "0..9999" -- "1..1" PetriNet_Node : outgoings4
PetriNet_Arc "1..1" -- "1..1" PetriNet_Node : source10

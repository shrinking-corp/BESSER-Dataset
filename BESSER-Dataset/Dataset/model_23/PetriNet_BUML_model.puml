@startuml
enum ArcKind {
  normal
  read_arc
}
class Node {
}
class PetriNet_Arc {
  + kind : str
  + weight : int
}
abstract class PetriNet_Node {
  + name : str
}
class PetriNet_PetriNet {
  + name : str
}
class PetriNet_Place {
  + marking : int
}

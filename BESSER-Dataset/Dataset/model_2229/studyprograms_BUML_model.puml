@startuml
' model: studyprograms
' project: sampleModel
' owner: User
' description: New project
enum Access {
  M1A
  M2A
  NoAccess
  O
  VA
  VB
}
enum AvailableSemesters {
  Both
  Fall
  Spring
}
enum Level {
  Bachelor
  Master
}
enum SemesterType {
  Fall
  Spring
}
class studyprograms_Course {
  + availableSemester : str
  + code : str
  + ects : float
  + level : str
  + name : str
}
class studyprograms_CourseAccess {
  + Access : str
}
class studyprograms_Department {
  + code : str
  + name : str
}
class studyprograms_IndividualStudyPlan {
  + studentNo : str
}
class studyprograms_Programme {
  + code : str
  + duration : int
  + name : str
  + startYear : int
}
class studyprograms_Semester {
  + semesterCode : str
  + semesterType : str
  + year : int
}
class studyprograms_Specialisation {
  + name : str
  + startSemester : int
}
studyprograms_CourseAccess "studyprograms_Semester9 0..9999" --* "studyprograms_CourseAccess 1..1" studyprograms_Semester : courseAccess8

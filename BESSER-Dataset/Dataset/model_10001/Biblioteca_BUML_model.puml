@startuml
' model: Biblioteca
' project: sampleModel
' owner: User
' description: New project
class Biblioteca_Autor {
  + fechaDeNacimiento : date
  + nacionalidad : str
  + nombreCompleto : str
}
class Biblioteca_Biblioteca {
  + direccion : str
}
class Biblioteca_Ejemplar {
  + estado : str
  + numeroDeEjemplar : int
}
class Biblioteca_Libro {
  + ISBN : str
  + activo : bool
  + anioDeEdicion : int
  + editorial : str
  + genero : str
  + titulo : str
}
class Biblioteca_Multa {
  + diasExcedidos : int
  + fecha : date
  + fechaDePago : date
  + monto : int
}
class Biblioteca_Prestamo {
  + fechaDeDevolucion : date
  + fechaDeFin : date
  + fechaDeInicio : date
}
class Biblioteca_Socio {
  + direccion : str
  + edad : int
  + fechaDeNacimiento : date
  + nombreCompleto : str
  + numeroDeSocio : int
  + telefono : str
  + devolverEjemplar(Biblioteca_codigo : str, Biblioteca_fechaActual : str) : str
  + existeSocio(Biblioteca_nombreDeSocio : str) : str
  + generarMulta(Biblioteca_prestamo : str) : str
  + solicitarEjemplar(Biblioteca_codigo : str) : str
  + uniqueID() : void
}
enum Estado {
  Bueno
  Malo
}
enum Genero {
  Didactico
  Dramatico
  Epico
  Lirico
  Narrativo
  Terror
}
Biblioteca_Autor "Biblioteca_Libro6 1..1" -- "Biblioteca_Autor7 1..1" Biblioteca_Libro : autor5
Biblioteca_Autor "Biblioteca_Biblioteca2 0..9999" --* "Biblioteca_Autor 1..1" Biblioteca_Biblioteca : autores1
Biblioteca_Ejemplar "Biblioteca_Prestamo 1..1" -- "Biblioteca_Ejemplar 1..1" Biblioteca_Prestamo : ejemplar8
Biblioteca_Biblioteca "Biblioteca_Libro 1..1" *-- "Biblioteca_Biblioteca 0..9999" Biblioteca_Libro : libros0
Biblioteca_Multa "Biblioteca_Socio16 0..9999" -- "Biblioteca_Multa 1..1" Biblioteca_Socio : multas15
Biblioteca_Autor "Biblioteca_Libro14 1..1" -- "Biblioteca_Autor13 1..9999" Biblioteca_Libro : obras12
Biblioteca_Multa "Biblioteca_Prestamo22 1..1" -- "Biblioteca_Multa21 1..1" Biblioteca_Prestamo : prestamo20
Biblioteca_Prestamo "Biblioteca_Socio18 0..3" -- "Biblioteca_Prestamo19 1..1" Biblioteca_Socio : prestamos17
Biblioteca_Prestamo "Biblioteca_Socio11 1..1" -- "Biblioteca_Prestamo10 1..1" Biblioteca_Socio : socio9
Biblioteca_Biblioteca "Biblioteca_Socio 1..1" *-- "Biblioteca_Biblioteca4 0..9999" Biblioteca_Socio : socios3
@enduml
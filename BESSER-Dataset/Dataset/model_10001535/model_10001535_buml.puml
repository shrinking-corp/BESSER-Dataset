@startuml
class AcademicRecords {
  + attendance : str
  + dues : int
  + result : AcademicResult
  + student : Student
}
class AcademicResult {
  + semester : int
}
class Administrator {
  + administratorID : int
  + name : str
}
class Course {
  + courseName : str
  + subjectCode : str
}
class Department {
  + course : Course
  + name : str
}
class FacultyInfo {
  + department : Department
  + facultyID : str
  + facultyName : str
}
class Portal {
}
class Student {
  + branch : Department
  + name : str
  + scholarNo : int
  + semester : int
}
AcademicRecords "0..1" -- "0..1" AcademicResult : AcademicRecords_AcademicResult
AcademicRecords "0..1" -- "0..1" Administrator : AcademicRecords_Administrator
AcademicRecords "0..1" -- "0..1" Student : AcademicRecords_Student
Course "0..1" -- "0..1" Department : Department_Course
Department "0..1" -- "0..1" Student : Department_Student
Department "0..1" -- "0..1" FacultyInfo : FacultyInfo_Department
AcademicRecords "0..1" -- "0..1" Portal : Portal_AcademicRecords
@enduml
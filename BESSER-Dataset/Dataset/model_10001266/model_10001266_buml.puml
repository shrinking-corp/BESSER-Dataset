@startuml
class Delivery {
  + Date : str
  + Name : str
  + Type : str
}
class Discription {
  + Discription : str
  + Emil : str
}
class Order {
  + ID_ : int
  + Quantity : int
  + Size_ : int
  + Type_ : str
}
class Payment {
  + Amount : int
  + Date_off : str
}
class User {
  + Address_ : str
  + Email_ : str
  + Name_ : str
  + Phone_number : int
  + Phone_number1 : int
}
@enduml
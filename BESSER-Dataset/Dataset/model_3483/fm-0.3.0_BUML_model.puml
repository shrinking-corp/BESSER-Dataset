@startuml
enum AttributeType {
  BOOLEAN
  DOUBLE
  INTEGER
  STRING
}
class fm_Attribute {
  + comment : str
  + description : str
  + id : str
  + name : str
  + type : str
  + value : str
}
class fm_Constraint {
  + comment : str
  + description : str
  + language : str
  + value : str
}
class fm_EObject {
}
class fm_Feature {
  + cloneable : bool
  + comment : str
  + description : str
  + id : str
  + lower : int
  + mandatory : bool
  + name : str
  + optional : bool
  + orphan : bool
  + root : bool
  + upper : int
}
class fm_FeatureModel {
  + comment : str
  + description : str
  + name : str
  + version : str

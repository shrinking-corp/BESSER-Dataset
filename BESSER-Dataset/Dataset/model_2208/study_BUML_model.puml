@startuml
enum Season {
  FALL
  SPRING
}
class study_Course {
  + code : str
  + credits : float
  + level : int
  + name : str
}
class study_Department {
  + name : str
}
class study_Programme {
  + code : str
  + duration : int
  + name : str
}
class study_Semester {
  + Season : str
  + year : int
}
class study_SemesterCourse {
  + mandatory : bool
}
class study_Specialization {
  + name : str
}

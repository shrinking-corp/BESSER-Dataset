@startuml
class Booking {
  + b_id : int
  + contact_no : int
  + customer_name : str
  + date : date
  + email_id : str
  + endTime : str
  + reservedTables : str
  + startTime : str
}
class Customer {
  + c_address : str
  + c_email : str
  + c_id : int
  + c_mobile : int
  + c_name : str
}
class CustomerUI {
}
class Food {
  + food_id : str
  + name : str
  + prepared : bool
  + price : float
  + served : bool
}
class Order {
  + foodList : str
  + order_id : str
}
class Report {
  + orders : str
  + report_id : str
}
class ReservationManagementSystem {
  + bookings : str
}
class Restaurants {
  + r_ID : int
  + r_address : str
  + r_contact : int
  + r_cuisine : str
  + r_name : str
}
class Table {
  + avaliable : bool
  + numSeats : int
  + table_id : str
}
CustomerUI "0..9999" -- "1..1" ReservationManagementSystem : CustomerUI_ReservationManagementSystem
Food "1..9999" -- "1..1" Order : Order_Food
Booking "0..9999" -- "1..1" ReservationManagementSystem : ReservationManagementSystem_Booking
Report "0..9999" -- "1..1" ReservationManagementSystem : ReservationManagementSystem_Report
Booking "0..1" -- "0..1" Restaurants : Restaurants_Booking2
Restaurants "1..1" -- "1..9999" Table : Table_Booking
Order "1..1" -- "1..1" Table : Table_Order
@enduml
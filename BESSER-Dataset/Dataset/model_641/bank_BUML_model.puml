  + accountNumber : str
  + balance : float
}
class BankingSystem_Bank {
  + bankId : int
  + description : str
  + name : str
}
class BankingSystem_Branch {
  + branchId : int
  + location : str
  + name : str
  + phoneNumber : str
}
class BankingSystem_Chequing {
}
class BankingSystem_Customer {
  + address : str
  + age : int
  + customerType : str
  + name : str
  + phoneNumber : str
}
abstract class BankingSystem_Employee {
  + eaddress : str
  + eage : int
  + eid : int
  + ename : str
  + ephoneNumber : str

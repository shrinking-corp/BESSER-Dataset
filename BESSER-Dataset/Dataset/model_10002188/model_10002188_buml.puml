Cart "1..1" -- "1..1" User : Cart_User
Collection "1..1" -- "0..9999" Products : Collection_Products
Color "0..9999" -- "0..9999" Inventory : Color_Inventory
Cart "1..1" -- "0..9999" DetailCart : DetailCart_Cart
DetailOrder "0..9999" -- "1..1" Orders : DetailOrder_Orders
DetailOrder "1..1" -- "0..9999" Products : DetailOrder_Products
Gallery "0..9999" -- "1..1" Products : Gallery_Products
Orders "1..1" -- "1..1" User : Orders_User
DetailCart "1..1" -- "0..9999" Products : Products_DetailCart
Inventory "0..9999" -- "0..9999" Products : Products_Inventory
Inventory "0..9999" -- "0..9999" Size : Size_Inventory
Products "0..9999" -- "1..1" Type : Type_Products

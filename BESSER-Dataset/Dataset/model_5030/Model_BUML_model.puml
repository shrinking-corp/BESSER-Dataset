@startuml
' model: pickupnet
' project: sampleModel
' owner: User
' description: New project
enum ShipmentStatus {
  ASSIGNED
  DELIVERED
  NEW
  UNDERWAY
}
class pickupnet_Address {
  + text : str
}
class pickupnet_Customer {
  + id : str
  + name : str
  + twitterUserName : str
}
class pickupnet_Driver {
  + id : str
  + name : str
}
class pickupnet_GeoLocation {
  + lat : float
  + lon : float
}
class pickupnet_Shipment {
  + id : str
  + status : str
}
class pickupnet_Station {
  + acceptShipment(pickupnet_shipment : str) : void
  + registerCustomer(pickupnet_customer : str) : void
  + registerDriver(pickupnet_driver : str) : void
}
pickupnet_Driver "Shipment 1..1" -- "driver 0..9999" pickupnet_Shipment : assignments5
pickupnet_Customer "pickupnet_Station 0..9999" --* "pickupnet_Customer 1..1" pickupnet_Station : customers0
pickupnet_Driver "assignments 0..1" -- "Driver 1..1" pickupnet_Shipment : driver8
pickupnet_Driver "pickupnet_Station2 0..9999" --* "pickupnet_Driver 1..1" pickupnet_Station : drivers1
pickupnet_Address "pickupnet_GeoLocation 1..1" *-- "pickupnet_Address16 1..1" pickupnet_GeoLocation : geoLocation15

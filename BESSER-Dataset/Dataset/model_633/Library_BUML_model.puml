@startuml
' model: library
' project: sampleModel
' owner: User
' description: New project
class library_Book {
  + author : str
  + name : str
}
class library_BorrowedItem {
  + borrowDate : date
  + lastReturnDate : date
}
class library_Library {
  + name : str
}
class library_User {
  + name : str
}
library_Book "library 0..9999" --* "Book 1..1" library_Library : books0
library_BorrowedItem "user 0..9999" --* "BorrowedItem 1..1" library_User : borrowedItems4
library_Book "library_BorrowedItem 1..1" -- "library_Book 1..1" library_BorrowedItem : item7
library_Book "Library 1..1" -- "books 1..1" library_Library : library3
library_Library "users 1..1" -- "Library6 1..1" library_User : library5
library_BorrowedItem "User9 1..1" -- "borrowedItems 1..1" library_User : user8
library_Library "User 1..1" *-- "library2 0..9999" library_User : users1
@enduml
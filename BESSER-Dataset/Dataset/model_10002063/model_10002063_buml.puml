@startuml
class Cidade {
  + codigo : int
  + ddd : int
  + nome : str
}
class Exame {
  + codigo : int
  + descricao : str
  + procedimentos : str
  + valor : float
}
class Medico {
  + crm : int
  + nome : str
}
class Paciente {
  + cep : str
  + codigo : int
  + cpf : str
  + dataNascimento : str
  + endereco : str
  + nome : str
  + rg : str
  + telefone : str
}
class Pedido_Exame {
  + codigo : int
}
class UF {
  + nome : str
  + sigla : str
}
class float {
}
Cidade "1..1" -- "1..9999" Paciente : Cidade_Paciente
Medico "1..1" -- "0..9999" Pedido_Exame : Medico_Pedido_Exame
Cidade "1..1" -- "1..1" UF : MyClass_Cidade
Paciente "1..1" -- "1..9999" Pedido_Exame : Pedido_Exame_Paciente
@enduml
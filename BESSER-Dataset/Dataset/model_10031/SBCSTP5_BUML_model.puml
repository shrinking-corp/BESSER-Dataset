note top of SBCS_ControlProgram_Start
  constraint Start (OCL): context ControlProgram_Start inv: CPPost.mode = Mode_Normal
end note
note top of SBCS_ControlProgram_Start
  constraint TP5 (OCL): context ControlProgram inv: let CS:Snapshot = self.SnapshotControlProgram in let NS: Snapshot= CS.getNext()in (self.mode=Mode_Initialization and self.wlmdFailure) implies NS.ControlProgramSnapshot.mode=Mode_EmergencyStop
end note
note top of SBCS_PumpController_ClosePump
  constraint ClosePump (OCL): context PumpController_ClosePump inv: PCPre.PumpControlerPump.mode = State_On implies PCPost.PumpControlerPump.mode = State_Off
end note
note top of SBCS_PumpController_OpenPump
  constraint OpenPump (OCL): context PumpController_OpenPump inv: PCPre.PumpControlerPump.mode = State_Off implies PCPost.PumpControlerPump.mode = State_On
end note
note top of SBCS_SteamBoiler
  constraint SB (OCL): context SteamBoiler inv: self.valveOpen=ValveState_Open implies self.SteamBoilerControlProgram.mode=Mode_Initialization
end note
note top of SBCS_SteamBoiler_OpenValve
  constraint OpenValve (OCL): context SteamBoiler_OpenValve inv: SBPre.valveOpen = ValveState_Closed implies SBPost.valveOpen = ValveState_Open
end note
note top of SBCS_WaterLevelMeaurementDevice_getLevel
  constraint getLevel (OCL): context WaterLevelMeaurementDevice_getLevel inv: wlmdPost.waterLevel = ret
end note

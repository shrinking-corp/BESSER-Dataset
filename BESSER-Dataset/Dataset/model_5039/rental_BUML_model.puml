@startuml
enum StreetType {
  Road
  Street
}
class rental_Address {
  + city : str
  + number : int
  + streetName : str
  + streetType : str
  + zipCode : str
}
class rental_Customer {
  + firstName : str
  + lastName : str
  + getDisplayName() : str
}
class rental_License {
  + number : int
  + validityDate : date
}
class rental_Rental {
  + endDate : date
  + startDate : date
  + end() : int
  + nbDaysBooked() : int
  + nbDaysRented() : int
  + start() : int
}
class rental_RentalAgency {
  + name : str
  + addCustomer(rental_customer : str) : void
  + addObject(rental_object : str) : void
  + book(rental_customer : str, rental_from_ : str, rental_rentedObject : str, rental_to : str) : str
}
class rental_RentalObject {
  + ID : str
  + name : str
  + picture : str
  + isAvailable() : bool
  + rent(rental_customer : str) : str
}

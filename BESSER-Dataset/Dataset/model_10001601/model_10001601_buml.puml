}
Order "0..9999" -- "1..1" ShoppingCart1 : Account_Order
Payment "0..9999" -- "1..1" ShoppingCart1 : Account_Payment
ShoppingCart "1..1" -- "1..1" ShoppingCart1 : Account_ShoppingCart
LineItem "1..9999" -- "0..1" Order : Order_LineItem

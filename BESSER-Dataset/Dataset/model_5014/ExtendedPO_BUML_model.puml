@startuml
class Address {
}
class GlobalLocation {
}
enum OrderStatus {
  BackOrder
  Complete
  Pending
}
abstract class epo_Address {
  + country : str
  + name : str
}
class epo_CanadianAddress {
  + city : str
  + postalCode : str
  + province : str
  + street : str
}
class epo_Customer {
  + customerID : int
}
class epo_GlobalAddress {
  + location : str
}
class epo_GlobalLocation {
  + countryCode : int
}
class epo_Item {
  + USPrice : int
  + comment : str
  + partNum : str
  + productName : str
  + quantity : int
  + shipDate : str
}
class epo_PurchaseOrder {
  + comment : str
  + orderDate : str
  + status : str
  + totalAmount : int
}
class epo_Supplier {
  + name : str
}
class epo_USAddress {
  + city : str
  + state : str
  + street : str
  + zip : int
}

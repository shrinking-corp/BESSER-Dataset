@startuml
class primitives_Bag {
  + id : str
}
class primitives_Primitive {
  + bigdecimal : str
  + bigint : str
  + boolean : bool
  + booleanObj : str
  + byte : str
  + byteArray : str
  + byteObj : str
  + char : str
  + characterObj : str
  + date : date
  + double : float
  + doubleObj : str
  + float : float
  + floatObj : str
  + int : int
  + integerObj : str

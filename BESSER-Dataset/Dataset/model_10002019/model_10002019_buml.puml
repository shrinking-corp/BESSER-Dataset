@startuml
class City {
  + city : str
  + id : int
}
class Guest {
  + Nmae : str
  + Phone_no_ : int
  + address : str
  + id : int
}
class Hotels {
  + id : int
  + location : int
  + name : int
}
class Manager {
  + Address : str
  + ID : int
  + Name : str
  + Phn_no_ : Manager
}
class Payment {
  + amount : int
  + card_no : int
  + card_type : str
  + cvv : int
  + password : int
}
class Rooms {
  + id : int
  + name : str
  + price : int
  + room_description : str
}
class User {
  + Name : str
  + address : str
  + id : int
  + mail_id : str
  + password : int
  + phn_no : int
}
City "1..1" -- "0..1" Hotels : City_Hotels
Guest "0..1" -- "0..1" Payment : Guest_Payment
Guest "0..1" -- "0..1" Hotels : Hotels_Guest
Hotels "0..1" -- "0..1" Rooms : Hotels_Rooms
Guest "0..1" -- "0..1" Manager : Manager_Guest
Manager "0..1" -- "0..1" Payment : Manager_Payment
Guest "0..1" -- "0..1" Rooms : Rooms_Guest
Guest "0..1" -- "0..1" User : User_Guest
@enduml
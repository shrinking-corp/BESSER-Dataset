}
class Test_Report {
}
class array_enum_ {
}
BackgroundStopLoader "1..1" -- "0..1" Car : Car_BackgroundStopLoader
Call "0..9999" -- "0..1" Car : Car_Call
Car "0..1" -- "1..1" CarCallBox : Car_CarCallBox
BackgroundCallListener "1..1" -- "0..1" Controller : Director_BackgroundCallListener
Call "0..9999" -- "0..1" Controller : Director_Call
Car "0..9999" -- "0..1" Controller : Director_Car
Controller "1..1" -- "1..9999" Floor : Director_Floor
Floor "0..1" -- "1..1" FloorCallBox : Floor_FloorCallBox
Controller "1..1" -- "1..1" Sim : Sim_Director
Passenger "0..9999" -- "1..1" Sim : Sim_Passenger
@enduml
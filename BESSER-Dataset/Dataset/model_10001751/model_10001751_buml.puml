@startuml
class Administrative_Staff {
  + FrontDeskStaffName : str
  + ReceptionistName : str
}
class Hospital {
  + Address : str
  + HospitalId : int
  + Name : str
  + Phone : int
}
class Operation_Staff {
  + DoctorLocation : str
  + DoctorSpeciality : str
  + NurseName : str
}
class Patient {
  + Age : int
  + Birthdate : str
  + DateOfEntry : str
  + Gender : str
  + Name : str
  + PatientId : int
  + Sickness : str
}
class Person {
  + Address : str
  + BirthDate : str
  + FirstName : str
  + Gender : str
  + LastName : str
  + MiddleName : str
  + PersonHospitalId : int
  + PersonPatientId : int
  + Phone : int
  + Title : str
}
class Staff {
  + Certification : str
  + Education : str
  + Joined : str
  + Languages : str
}
class Techinal_Staff {
  + Technician : str
  + Technologist : str
}
Operation_Staff "0..9999" -- "0..9999" Patient : Operation_Staff_Patient
Hospital "0..9999" -- "0..9999" Person : Person_Hospital
Hospital "0..9999" -- "0..9999" Staff : Staff_Hospital
@enduml
@startuml
class Ball {
}
enum BallType {
  dot_ball
  four_runs
  one_run
  six_runs
  three_runs
  two_runs
}
enum ExtraType {
  Bye
  LegBye
  NoBall
  Wide
}
enum HowOut {
  Bowled
  Caught
  Lbw
  Run_Out
  Stumped
}
class model_Ball {
  + runValue : int
  + runs : str
  + switchEnds : str
}
class model_ExtraBall {
  + extraType : str
  + isValidBall : str
}
class model_Game {
  + date : date
  + venue : str
}
class model_Innings {
  + Summary : str
  + noOvers : int
  + overCount : str
  + total : int
  + wicketsDown : int
  + bowlBall() : void
  + newOver(model_bowler : str) : str
}
class model_Over {
  + BALLS_IN_OVER : int
  + isComplete : bool
  + runs : int
  + validBalls : int
}
class model_Player {
  + howOut : str
  + name : str
  + noBallsFaced : int
  + noOversBowled : str
  + runsScored : int
}
class model_Team {
  + name : str
}
class model_WicketBall {
  + howOut : str
}
Ball <|-- model_ExtraBall
Ball <|-- model_WicketBall
model_Player "1..1" -- "1..1" model_WicketBall : assists27

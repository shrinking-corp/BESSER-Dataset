@startuml
class Cards {
  + Character : str
  + Suit : str
}
class Deck {
  + attribute : str
}
class Elevens {
  + _attr : Player
}
enum Enumeration {
}
class Player {
  + losses : int
  + winRate : str
  + wins : int
}
Cards "0..1" -- "0..1" Deck : Deck_Cards
Deck "0..1" -- "0..1" Elevens : Elevens_Deck
Elevens "0..1" -- "0..1" Player : Elevens_Player
@enduml